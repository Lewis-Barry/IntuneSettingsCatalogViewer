dd-in usage data.\r\n\r\nIf you disable or don't configure this policy setting, the Readiness Toolkit doesn't generate or collect add-in usage data.","categoryId":"da04d4b8-bd11-439e-9663-5fd2399d9cc1","baseUri":"./User/Vendor/MSFT/Policy","offsetUri":"/Config/office16v2~Policy~L_MicrosoftOfficeSystem~L_ReadinessToolkit/L_OfficeReadinessToolkitEnableUsageAgent","rootDefinitionId":"user_vendor_msft_policy_config_office16v2~policy~l_microsoftofficesystem~l_readinesstoolkit_l_officereadinesstoolkitenableusageagent","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"user_vendor_msft_policy_config_office16v2~policy~l_microsoftofficesystem~l_readinesstoolkit_l_officereadinesstoolkitenableusageagent_0","options":[{"itemId":"user_vendor_msft_policy_config_office16v2~policy~l_microsoftofficesystem~l_readinesstoolkit_l_officereadinesstoolkitenableusageagent_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"user_vendor_msft_policy_config_office16v2~policy~l_microsoftofficesystem~l_readinesstoolkit_l_officereadinesstoolkitenableusageagent_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"user_vendor_msft_policy_config_office16v2~policy~l_microsoftofficesystem~l_readinesstoolkit_l_officereadinesstoolkitcustomtags_l_officereadinesstoolkitcustomtagstag3","name":"L_OfficeReadinessToolkitCustomTagsTag3","displayName":"Label 3: (User)","categoryId":"da04d4b8-bd11-439e-9663-5fd2399d9cc1","baseUri":"./User/Vendor/MSFT/Policy","offsetUri":"/Config/office16v2~Policy~L_MicrosoftOfficeSystem~L_ReadinessToolkit/L_OfficeReadinessToolkitCustomTags","rootDefinitionId":"user_vendor_msft_policy_config_office16v2~policy~l_microsoftofficesystem~l_readinesstoolkit_l_officereadinesstoolkitcustomtags","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagement