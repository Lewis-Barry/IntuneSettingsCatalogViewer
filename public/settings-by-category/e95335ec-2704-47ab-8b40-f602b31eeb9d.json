ts for uploads or downloads. Set the port to 0 to pick a random, available port.","categoryId":"e95335ec-2704-47ab-8b40-f602b31eeb9d","offsetUri":"Port","rootDefinitionId":"com.apple.assetcache.managed_com.apple.assetcache.managed","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"com.apple.assetcache.managed_peerfilterranges_item_last","name":"PeerFilterRanges_item_last","displayName":"Last","description":"The last IP address in the range.","categoryId":"e95335ec-2704-47ab-8b40-f602b31eeb9d","offsetUri":"PeerFilterRanges/[{0}]/last","rootDefinitionId":"com.apple.assetcache.managed_com.apple.assetcache.managed","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"com.apple.assetcache.managed_cachelimit","name":"CacheLimit","displayName":"Cache Limit","description":"The maximum number of bytes of disk space that will be used for the content cache. A value of 0 means unlimited disk space.","categoryId":"e95335ec-2704-47ab-8b40-f602b31eeb9d","offsetUri":"CacheLimit","rootDefinitionId":"com.apple.assetcache.managed_com.apple.assetcache.managed","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSettingGroupCollectionDefinition","id":"com.apple.assetcache.managed_listenranges","name":"ListenRanges","displayName":"Listen Ranges","description":"The range of client IP addresses to serve.","categoryId":"e95335ec-2704-47ab-8b40-f602b31eeb9d","offsetUri":"ListenRanges","rootDefinitionId":"com.apple.assetcache.managed_com.apple.assetcache.managed","uxBehavior":"contextPane","applicability":{"platform":"macOS","technologies":"m