[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}_wirelesstype","name":"WirelessType","displayName":"Wireless Type (Windows Insiders only)","description":"Type of wireless network (either Cellular or Wi-Fi). 0 represents Cellular, and 1 represents Wi-Fi. Currently only cellular is supported.\r\n This setting is only available to Windows Insiders","categoryId":"0d9ee4f5-7d6b-41fd-9089-b0886f7ff944","baseUri":"./Vendor/MSFT/WirelessNetworkPreference","offsetUri":"/ConnectionProfiles/{0}/WirelessType","rootDefinitionId":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/WirelessNetworkPreference-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}_wirelesstype_0","options":[{"itemId":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}_wirelesstype_0","displayName":"Cellular","dependedOnBy":[]},{"itemId":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}_wirelesstype_1","displayName":"Wi- Fi","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSettingGroupCollectionDefinition","id":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}","name":"{ConnectionProfileID}","displayName":" Connection Profile ID (Windows Insiders only)","description":"Unique identifier of a network preference policy. Unique ID is auto-generated.\r\n This setting is only available to Windows Insiders","categoryId":"0d9ee4f5-7d6b-41fd-9089-b0886f7ff944","baseUri":"./Vendor/MSFT/WirelessNetworkPreference","offsetUri":"/ConnectionProfiles/{0}","rootDefinitionId":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[{"dependedOnBy":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}_priority","required":false},{"dependedOnBy":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}_stayconnected","required":false},{"dependedOnBy":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}_wirelesstype","required":false},{"dependedOnBy":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}_cellular_plmnid","required":false}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"vendor_msft_wirelessnetworkpreference_parameters_cellularparameters_maxrescanintervalinseconds","name":"MaxRescanIntervalInSeconds","displayName":"Max Rescan Interval In Seconds (Windows Insiders only)","description":"Maximum time (in seconds) from the point that no connection could be established using the permissible eSIM profiles on the device to the start of the next round of network discovery attempts. A smaller interval increases network discovery frequency and can decrease battery life significantly. A value of 0 means that the device is to pick a reasonable interval per its own discretion.\r\n This setting is only available to Windows Insiders","categoryId":"0d9ee4f5-7d6b-41fd-9089-b0886f7ff944","baseUri":"./Vendor/MSFT/WirelessNetworkPreference","offsetUri":"/Parameters/CellularParameters/MaxRescanIntervalInSeconds","rootDefinitionId":"vendor_msft_wirelessnetworkpreference_parameters_cellularparameters_maxrescanintervalinseconds","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/WirelessNetworkPreference-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"vendor_msft_wirelessnetworkpreference_parameters_cellularparameters_preferredprofilewakeconnectiontimerinseconds","name":"PreferredProfileWakeConnectionTimerInSeconds","displayName":"Preferred Profile Wake Connection Timer In Seconds (Windows Insiders only)","description":"When the device is woken from sleep with the most-preferred profile already enabled, this value configures the amount of time (in seconds) before the agent will give up on waiting for connection re-establishment with the most-preferred profile and start network discovery.\r\n This setting is only available to Windows Insiders","categoryId":"0d9ee4f5-7d6b-41fd-9089-b0886f7ff944","baseUri":"./Vendor/MSFT/WirelessNetworkPreference","offsetUri":"/Parameters/CellularParameters/PreferredProfileWakeConnectionTimerInSeconds","rootDefinitionId":"vendor_msft_wirelessnetworkpreference_parameters_cellularparameters_preferredprofilewakeconnectiontimerinseconds","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/WirelessNetworkPreference-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"vendor_msft_wirelessnetworkpreference_isenabled","name":"IsEnabled","displayName":"Is Enabled (Windows Insiders only)","description":"It determines whether the wireless connectivity management policy is enabled or not.\r\n This setting is only available to Windows Insiders","categoryId":"0d9ee4f5-7d6b-41fd-9089-b0886f7ff944","baseUri":"./Vendor/MSFT/WirelessNetworkPreference","offsetUri":"/IsEnabled","rootDefinitionId":"vendor_msft_wirelessnetworkpreference_isenabled","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/WirelessNetworkPreference-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"vendor_msft_wirelessnetworkpreference_isenabled_false","options":[{"itemId":"vendor_msft_wirelessnetworkpreference_isenabled_false","displayName":"Disable the wireless management policy.","dependedOnBy":[]},{"itemId":"vendor_msft_wirelessnetworkpreference_isenabled_true","displayName":"Enable the wireless management policy.","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}_connectionprofileid","name":"ConnectionProfileID","displayName":null,"categoryId":"0d9ee4f5-7d6b-41fd-9089-b0886f7ff944","baseUri":"./Vendor/MSFT/WirelessNetworkPreference","offsetUri":"/ConnectionProfiles/{0}/ConnectionProfileID","rootDefinitionId":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}_cellular_plmnid","name":"PLMNID","displayName":"PLMNID (Windows Insiders only)","description":"5- or 6-digit string identifying a cellular network. It consists of the combination of Mobile Country Code (MCC) and Mobile Network Code (MNC). \r\n This setting is only available to Windows Insiders","categoryId":"0d9ee4f5-7d6b-41fd-9089-b0886f7ff944","baseUri":"./Vendor/MSFT/WirelessNetworkPreference","offsetUri":"/ConnectionProfiles/{0}/Cellular/PLMNID","rootDefinitionId":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/WirelessNetworkPreference-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"vendor_msft_wirelessnetworkpreference_parameters_cellularparameters_profileregistrationtimerinseconds","name":"ProfileRegistrationTimerInSeconds","displayName":"Profile Registration Timer In Seconds (Windows Insiders only)","description":"When evaluating eSIM profiles for connectivity, this value configures the amount of time (in seconds) that the agent will wait for network registration before considering this profile unsatisfactory and moving on to the next one.\r\n This setting is only available to Windows Insiders","categoryId":"0d9ee4f5-7d6b-41fd-9089-b0886f7ff944","baseUri":"./Vendor/MSFT/WirelessNetworkPreference","offsetUri":"/Parameters/CellularParameters/ProfileRegistrationTimerInSeconds","rootDefinitionId":"vendor_msft_wirelessnetworkpreference_parameters_cellularparameters_profileregistrationtimerinseconds","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/WirelessNetworkPreference-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"vendor_msft_wirelessnetworkpreference_parameters_cellularparameters_screenoffdurationtotriggernetworkdiscoveryinminutes","name":"ScreenOffDurationToTriggerNetworkDiscoveryInMinutes","displayName":"Screen Off Duration To Trigger Network Discovery In Minutes (Windows Insiders only)","description":"When the device experiences screen off and back on, this value configures the minimum duration (in minutes) of the screen off period that will trigger network discovery.\r\n This setting is only available to Windows Insiders","categoryId":"0d9ee4f5-7d6b-41fd-9089-b0886f7ff944","baseUri":"./Vendor/MSFT/WirelessNetworkPreference","offsetUri":"/Parameters/CellularParameters/ScreenOffDurationToTriggerNetworkDiscoveryInMinutes","rootDefinitionId":"vendor_msft_wirelessnetworkpreference_parameters_cellularparameters_screenoffdurationtotriggernetworkdiscoveryinminutes","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/WirelessNetworkPreference-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}_priority","name":"Priority","displayName":"Priority (Windows Insiders only)","description":"Priority of a policy compared to the others where 1 represents the highest priority. Thus, the smaller this value is, the higher preference this specific network will receive in establishing a data connection. \r\n This setting is only available to Windows Insiders","categoryId":"0d9ee4f5-7d6b-41fd-9089-b0886f7ff944","baseUri":"./Vendor/MSFT/WirelessNetworkPreference","offsetUri":"/ConnectionProfiles/{0}/Priority","rootDefinitionId":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/WirelessNetworkPreference-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}_stayconnected","name":"StayConnected","displayName":"Stay Connected (Windows Insiders only)","description":"When set to 0: Default network discovery behavior is applied. When set to 1: Once connected, the device will always stay connected to this network. This means the device will not attempt to discover or switch to other higher priority networks until it first loses connectivity to this network.\r\n This setting is only available to Windows Insiders","categoryId":"0d9ee4f5-7d6b-41fd-9089-b0886f7ff944","baseUri":"./Vendor/MSFT/WirelessNetworkPreference","offsetUri":"/ConnectionProfiles/{0}/StayConnected","rootDefinitionId":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/WirelessNetworkPreference-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}_stayconnected_0","options":[{"itemId":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}_stayconnected_0","displayName":"Default network discovery behavior.","dependedOnBy":[]},{"itemId":"vendor_msft_wirelessnetworkpreference_connectionprofiles_{connectionprofileid}_stayconnected_1","displayName":"Once connected to this network, try to stay connected.","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"vendor_msft_wirelessnetworkpreference_parameters_cellularparameters_networkdiscoveryoption","name":"NetworkDiscoveryOption","displayName":"Network Discovery Option (Windows Insiders only)","description":"Configures which approach should be used in the network discovery process. There are two possible values: (0) no network scan will be performed – rather, registration and connection will be attempted with each eSIM profile in descending order of preference; or (1) Network scan will be performed using the current active eSIM profile. This option works for modems that when performing a network scan show the complete list of available networks independently of which eSIM profile is active.\r\n This setting is only available to Windows Insiders","categoryId":"0d9ee4f5-7d6b-41fd-9089-b0886f7ff944","baseUri":"./Vendor/MSFT/WirelessNetworkPreference","offsetUri":"/Parameters/CellularParameters/NetworkDiscoveryOption","rootDefinitionId":"vendor_msft_wirelessnetworkpreference_parameters_cellularparameters_networkdiscoveryoption","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/WirelessNetworkPreference-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"vendor_msft_wirelessnetworkpreference_parameters_cellularparameters_networkdiscoveryoption_0","options":[{"itemId":"vendor_msft_wirelessnetworkpreference_parameters_cellularparameters_networkdiscoveryoption_0","displayName":"No network scan will be performed -- rather, registration and connection will be attempted with each eSIM profile in descending order of preference.","dependedOnBy":[]},{"itemId":"vendor_msft_wirelessnetworkpreference_parameters_cellularparameters_networkdiscoveryoption_1","displayName":"Network scan will be performed using the current active eSIM profile.","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"vendor_msft_wirelessnetworkpreference_prefercellularoverwifi","name":"PreferCellularOverWiFi","displayName":"Prefer Cellular Over Wi Fi (Windows Insiders only)","description":"It determines the order of preference between Wi-Fi and cellular networks. When the value is set to “False”, Wi-Fi is preferred over cellular. When the value is set to “True”, cellular is preferred over Wi-Fi. \r\n This setting is only available to Windows Insiders","categoryId":"0d9ee4f5-7d6b-41fd-9089-b0886f7ff944","baseUri":"./Vendor/MSFT/WirelessNetworkPreference","offsetUri":"/PreferCellularOverWiFi","rootDefinitionId":"vendor_msft_wirelessnetworkpreference_prefercellularoverwifi","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/WirelessNetworkPreference-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"vendor_msft_wirelessnetworkpreference_prefercellularoverwifi_false","options":[{"itemId":"vendor_msft_wirelessnetworkpreference_prefercellularoverwifi_false","displayName":"Prefer Wi-Fi over Cellular.","dependedOnBy":[]},{"itemId":"vendor_msft_wirelessnetworkpreference_prefercellularoverwifi_true","displayName":"Prefer Cellular over Wi-Fi.","dependedOnBy":[]}]}]