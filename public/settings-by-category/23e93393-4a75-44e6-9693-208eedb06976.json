porting/WerArchive_1","rootDefinitionId":"user_vendor_msft_policy_config_admx_errorreporting_werarchive_1","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"user_vendor_msft_policy_config_admx_errorreporting_werarchive_1_werarchivebehavior_2","options":[{"itemId":"user_vendor_msft_policy_config_admx_errorreporting_werarchive_1_werarchivebehavior_2","displayName":"Store all","dependedOnBy":[]},{"itemId":"user_vendor_msft_policy_config_admx_errorreporting_werarchive_1_werarchivebehavior_1","displayName":"Store parameters only","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_errorreporting_werarchive_2_werarchivebehavior","name":"WerArchiveBehavior","displayName":"Archive behavior: (Device)","categoryId":"23e93393-4a75-44e6-9693-208eedb06976","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_ErrorReporting/WerArchive_2","rootDefinitionId":"device_vendor_msft_policy_config_admx_errorreporting_werarchive_2","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_errorreporting_werarchive_2_werarchivebehavior_2","options":[{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_werarchive_2_werarchivebehavior_2","displayName":"Store all","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_werarchive_2_werarchivebehavior_1","displayName":"Store parameters only","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_errorreporting_wercer_wercercorporateportnumber","name":"WerCERCorporatePortNumber","displayName":"Server port: (Device)","categoryId":"23e93393-4a75-44e6-9693-208eedb06976","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_ErrorReporting/WerCER","rootDefinitionId":"device_vendor_msft_policy_config_admx_errorreporting_wercer","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornonedef","name":"PCH_AllOrNoneDef","displayName":"Default application reporting settings","description":"This policy setting controls whether errors in general applications are included in reports when Windows Error Reporting is enabled.\r\n\r\nIf you enable this policy setting, you can instruct Windows Error Reporting in the Default pull-down menu to report either all application errors (the default setting), or no application errors.\r\n\r\nIf the Report all errors in Microsoft applications check box is filled, all errors in Microsoft applications are reported, regardless of the setting in the Default pull-down menu. When the Report all errors in Windows check box is filled, all errors in Windows applications are reported, regardless of the setting in the Default dropdown list. The Windows applications category is a subset of Microsoft applications.\r\n\r\nIf you disable or do not configure this policy setting, users can enable or disable Windows Error Reporting in Control Panel. The default setting in Control Panel is Upload all applications.\r\n\r\nThis policy setting is ignored if the Configure Error Reporting policy setting is disabled or not configured.\r\n\r\nFor related information, see the Configure Error Reporting and Report Operating System Errors policy settings.\r\n ","categoryId":"23e93393-4a75-44e6-9693-208eedb06976","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_ErrorReporting/PCH_AllOrNoneDef","rootDefinitionId":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornonedef","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-errorreporting#admx-errorreporting-pch-allornonedef"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornonedef_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornonedef_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornonedef_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornonedef_pch_allornonedef_list","required":true},{"dependedOnBy":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornonedef_pch_allornoneincms_chk","required":true},{"dependedOnBy":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornonedef_pch_allornonewincomp_chk","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingCollectionDefinition","id":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornoneinc_pch_allornoneinc_list","name":"PCH_AllOrNoneInc_List","displayName":"Report errors for applications on this list: (Device)","categoryId":"23e93393-4a75-44e6-9693-208eedb06976","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_ErrorReporting/PCH_AllOrNoneInc","rootDefinitionId":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornoneinc","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"user_vendor_msft_policy_config_admx_errorreporting_werexlusion_1","name":"WerExlusion_1","displayName":"List of applications to be excluded (User)","description":"This policy setting limits Windows Error Reporting behavior for errors in general applications when Windows Error Reporting is turned on.\r\n\r\nIf you enable this policy setting, you can create a list of applications that are never included in error reports. To create a list of applications for which Windows Error Reporting never reports errors, click Show, and then add or remove applications from the list of application file names in the Show Contents dialog box (example: notepad.exe). File names must always include the .exe file name extension. To remove an application from the list, click the name, and then press DELETE. If this policy setting is enabled, the Exclude errors for applications on this list setting takes precedence.\r\n\r\nIf you disable or do not configure this policy setting, errors are reported on all Microsoft and Windows applications by default.\r\n ","categoryId":"23e93393-4a75-44e6-9693-208eedb06976","baseUri":"./User/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_ErrorReporting/WerExlusion_1","rootDefinitionId":"user_vendor_msft_policy_config_admx_errorreporting_werexlusion_1","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-errorreporting#admx-errorreporting-werexlusion-1"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"user_vendor_msft_policy_config_admx_errorreporting_werexlusion_1_0","options":[{"itemId":"user_vendor_msft_policy_config_admx_errorreporting_werexlusion_1_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"user_vendor_msft_policy_config_admx_errorreporting_werexlusion_1_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"user_vendor_msft_policy_config_admx_errorreporting_werexlusion_1_werexlusionlist","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"user_vendor_msft_policy_config_admx_errorreporting_werarchive_1","name":"WerArchive_1","displayName":"Configure Report Archive (User)","description":"This policy setting controls the behavior of the Windows Error Reporting archive.\r\n\r\nIf you enable this policy setting, you can configure Windows Error Reporting archiving behavior. If Archive behavior is set to Store all, all data collected for each error report is stored in the appropriate location. If Archive behavior is set to Store parameters only, only the minimum information required to check for an existing solution is stored. The Maximum number of reports to store setting determines how many reports are stored before older reports are automatically deleted.\r\n\r\nIf you disable or do not configure this policy setting, no Windows Error Reporting information is stored.\r\n ","categoryId":"23e93393-4a75-44e6-9693-208eedb06976","baseUri":"./User/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_ErrorReporting/WerArchive_1","rootDefinitionId":"user_vendor_msft_policy_config_admx_errorreporting_werarchive_1","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-errorreporting#admx-errorreporting-werarchive-1"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"user_vendor_msft_policy_config_admx_errorreporting_werarchive_1_0","options":[{"itemId":"user_vendor_msft_policy_config_admx_errorreporting_werarchive_1_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"user_vendor_msft_policy_config_admx_errorreporting_werarchive_1_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"user_vendor_msft_policy_config_admx_errorreporting_werarchive_1_werarchivebehavior","required":true},{"dependedOnBy":"user_vendor_msft_policy_config_admx_errorreporting_werarchive_1_wermaxarchivecount","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"user_vendor_msft_policy_config_admx_errorreporting_werqueue_1_wermaxqueuecount","name":"WerMaxQueueCount","displayName":"Maximum number of reports to queue: (User)","categoryId":"23e93393-4a75-44e6-9693-208eedb06976","baseUri":"./User/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_ErrorReporting/WerQueue_1","rootDefinitionId":"user_vendor_msft_policy_config_admx_errorreporting_werqueue_1","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_errorreporting_werqueue_2_werqueuebehavior","name":"WerQueueBehavior","displayName":"Queuing behavior: (Device)","categoryId":"23e93393-4a75-44e6-9693-208eedb06976","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_ErrorReporting/WerQueue_2","rootDefinitionId":"device_vendor_msft_policy_config_admx_errorreporting_werqueue_2","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_errorreporting_werqueue_2_werqueuebehavior_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_werqueue_2_werqueuebehavior_0","displayName":"Default","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_werqueue_2_werqueuebehavior_1","displayName":"Always queue","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_werqueue_2_werqueuebehavior_2","displayName":"Always queue for administrator","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_errorreporting_wercer_werceruploadonfreenetworksonly","name":"WerCerUploadOnFreeNetworksOnly","displayName":"Only upload on free networks (Device)","categoryId":"23e93393-4a75-44e6-9693-208eedb06976","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_ErrorReporting/WerCER","rootDefinitionId":"device_vendor_msft_policy_config_admx_errorreporting_wercer","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_errorreporting_wercer_werceruploadonfreenetworksonly_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_wercer_werceruploadonfreenetworksonly_0","displayName":"False","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_wercer_werceruploadonfreenetworksonly_1","displayName":"True","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornoneinc","name":"PCH_AllOrNoneInc","displayName":"List of applications to always report errors for","description":"This policy setting specifies applications for which Windows Error Reporting should always report errors.\r\n\r\nTo create a list of applications for which Windows Error Reporting never reports errors, click Show under the Exclude errors for applications on this list setting, and then add or remove applications from the list of application file names in the Show Contents dialog box (example: notepad.exe). Errors that are generated by applications in this list are not reported, even if the Default Application Reporting Settings policy setting is configured to report all application errors.\r\n\r\nIf you enable this policy setting, you can create a list of applications that are always included in error reporting. To add applications to the list, click Show under the Report errors for applications on this list setting, and edit the list of application file names in the Show Contents dialog box. The file names must include the .exe file name extension (for example, notepad.exe). Errors that are generated by applications on this list are always reported, even if the Default dropdown in the Default application reporting policy setting is set to report no application errors.\r\n\r\nIf the Report all errors in Microsoft applications or Report all errors in Windows components check boxes in the Default Application Reporting policy setting are filled, Windows Error Reporting reports errors as if all applications in these categories were added to the list in this policy setting. (Note: The Microsoft applications category includes the Windows components category.)\r\n\r\nIf you disable this policy setting or do not configure it, the Default application reporting settings policy setting takes precedence.\r\n\r\nAlso see the \"Default Application Reporting\" and \"Application Exclusion List\" policies.\r\n\r\nThis setting will be ignored if the 'Configure Error Reporting' setting is disabled or not configured.\r\n ","categoryId":"23e93393-4a75-44e6-9693-208eedb06976","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_ErrorReporting/PCH_AllOrNoneInc","rootDefinitionId":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornoneinc","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-errorreporting#admx-errorreporting-pch-allornoneinc"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornoneinc_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornoneinc_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornoneinc_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_errorreporting_pch_allornoneinc_pch_allornoneinc_list","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_errorreporting_wercer","name":"WerCER","displayName":"Configure Corporate Windows Error Reporting","description":"This policy setting specifies a corporate server to which Windows Error Reporting sends reports (if you do not want to send error reports to Microsoft).\r\n\r\nIf you enable this policy setting, you can specify the name or IP address of an error report destination server on your organization’s network. You can also select Connect using SSL to transmit error reports over a Secure Sockets Layer (SSL) connection, and specify a port number on the destination server for transmission.\r\n\r\nIf you disable or do not configure this policy setting, Windows Error Reporting sends error reports to Microsoft.\r\n ","categoryId":"23e93393-4a75-44e6-9693-208eedb06976","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_ErrorReporting/WerCER","rootDefinitionId":"device_vendor_msft_policy_config_admx_errorreporting_wercer","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-errorreporting#admx-errorreporting-wercer"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_errorreporting_wercer_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_wercer_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_wercer_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_errorreporting_wercer_wercerserver","required":true},{"dependedOnBy":"device_vendor_msft_policy_config_admx_errorreporting_wercer_wercerusessl","required":true},{"dependedOnBy":"device_vendor_msft_policy_config_admx_errorreporting_wercer_werceruploadonfreenetworksonly","required":true},{"dependedOnBy":"device_vendor_msft_policy_config_admx_errorreporting_wercer_wercercorporateportnumber","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_errorreporting_pch_reportoperatingsystemfaults","name":"PCH_ReportOperatingSystemFaults","displayName":"Report operating system errors","description":"This policy setting controls whether errors in the operating system are included Windows Error Reporting is enabled.\r\n\r\nIf you enable this policy setting, Windows Error Reporting includes operating system errors.\r\n\r\nIf you disable this policy setting, operating system errors are not included in error reports.\r\n\r\nIf you do not configure this policy setting, users can change this setting in Control Panel. By default, Windows Error Reporting settings in Control Panel are set to upload operating system errors.\r\n\r\nSee also the Configure Error Reporting policy setting.\r\n ","categoryId":"23e93393-4a75-44e6-9693-208eedb06976","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_ErrorReporting/PCH_ReportOperatingSystemFaults","rootDefinitionId":"device_vendor_msft_policy_config_admx_errorreporting_pch_reportoperatingsystemfaults","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-errorreporting#admx-errorreporting-pch-reportoperatingsystemfaults"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_errorreporting_pch_reportoperatingsystemfaults_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_pch_reportoperatingsystemfaults_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_pch_reportoperatingsystemfaults_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_errorreporting_werexlusion_2","name":"WerExlusion_2","displayName":"List of applications to be excluded","description":"This policy setting limits Windows Error Reporting behavior for errors in general applications when Windows Error Reporting is turned on.\r\n\r\nIf you enable this policy setting, you can create a list of applications that are never included in error reports. To create a list of applications for which Windows Error Reporting never reports errors, click Show, and then add or remove applications from the list of application file names in the Show Contents dialog box (example: notepad.exe). File names must always include the .exe file name extension. To remove an application from the list, click the name, and then press DELETE. If this policy setting is enabled, the Exclude errors for applications on this list setting takes precedence.\r\n\r\nIf you disable or do not configure this policy setting, errors are reported on all Microsoft and Windows applications by default.\r\n ","categoryId":"23e93393-4a75-44e6-9693-208eedb06976","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_ErrorReporting/WerExlusion_2","rootDefinitionId":"device_vendor_msft_policy_config_admx_errorreporting_werexlusion_2","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-errorreporting#admx-errorreporting-werexlusion-2"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_errorreporting_werexlusion_2_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_werexlusion_2_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_errorreporting_werexlusion_2_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_errorreporting_werexlusion_2_werexlusionlist","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_errorreporting_wercer_wercerserver","name":"WerCERServer","displayName":"Corporate server name: (Device)","categoryId":"23e93393-4a75-44e6-9693-208eedb06976","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_ErrorReporting/WerCER","rootDefinitionId":"device_vendor_msft_policy_config_admx_errorreporting_wercer","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx