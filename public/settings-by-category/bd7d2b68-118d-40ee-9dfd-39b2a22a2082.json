licy","offsetUri":"/Config/ADMX_WindowsConnectNow/WCN_EnableRegistrar","rootDefinitionId":"device_vendor_msft_policy_config_admx_windowsconnectnow_wcn_enableregistrar","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_windowsconnectnow_wcn_enableregistrar_wcn_higher_precedence_registrar_1","options":[{"itemId":"device_vendor_msft_policy_config_admx_windowsconnectnow_wcn_enableregistrar_wcn_higher_precedence_registrar_1","displayName":"WCN over Ethernet (UPnP)","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_windowsconnectnow_wcn_enableregistrar_wcn_higher_precedence_registrar_2","displayName":"WCN over In-band 802.11 WLAN","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_windowsconnectnow_wcn_enableregistrar_wcn_enableregistrar_disablewpd","name":"WCN_EnableRegistrar_DisableWPD","displayName":"Turn off ability to configure Windows Portable Device (WPD) (Device)","categoryId":"bd7d2b68-118d-40ee-9dfd-39b2a22a2082","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_WindowsConnectNow/WCN_EnableRegistrar","rootDefinitionId":"device_vendor_msft_policy_config_admx_windowsconnectnow_wcn_enableregistrar","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_windowsconnectnow_wcn_enableregistrar_wcn_enableregistrar_disablewpd_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_windowsconnectnow_wcn_enableregistrar_wcn_enableregistrar_disablewpd_0","displayName":"False","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_windowsconnectnow_wcn_enableregistrar_wcn_enableregistrar_disablewpd_1","displayName":"True","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_