[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver_start_time","name":"Start_Time","displayName":"Reporting Time","categoryId":"48f508a5-5a2c-4d20-8d89-2d352a209907","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/AppVirtualization/AllowReportingServer","rootDefinitionId":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver_data_block_size","name":"Data_Block_Size","displayName":"Data Block Size","categoryId":"48f508a5-5a2c-4d20-8d89-2d352a209907","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/AppVirtualization/AllowReportingServer","rootDefinitionId":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver_data_cache_limit","name":"Data_Cache_Limit","displayName":"Data Cache Limit","categoryId":"48f508a5-5a2c-4d20-8d89-2d352a209907","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/AppVirtualization/AllowReportingServer","rootDefinitionId":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver_interval","name":"Interval","displayName":"Repeat reporting for every (days)","categoryId":"48f508a5-5a2c-4d20-8d89-2d352a209907","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/AppVirtualization/AllowReportingServer","rootDefinitionId":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver_reporting_server_url_prompt","name":"Reporting_Server_URL_Prompt","displayName":"Reporting Server URL","categoryId":"48f508a5-5a2c-4d20-8d89-2d352a209907","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/AppVirtualization/AllowReportingServer","rootDefinitionId":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver_random_delay","name":"Random_Delay","displayName":"Delay reporting for the random minutes","categoryId":"48f508a5-5a2c-4d20-8d89-2d352a209907","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/AppVirtualization/AllowReportingServer","rootDefinitionId":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver","name":"Reporting_Server_Policy","displayName":"Reporting Server","description":"Reporting Server URL: Displays the URL of reporting server.\r\n\r\n      Reporting Time: When the client data should be reported to the server. Acceptable range is 0~23, corresponding to the 24 hours in a day. A good practice is, don't set this time to a busy hour, e.g. 9AM.\r\n      \r\n      Delay reporting for the random minutes: The maximum minutes of random delay on top of the reporting time. For a busy system, the random delay will help reduce the server load.\r\n      \r\n      Repeat reporting for every (days): The periodical interval in days for sending the reporting data.\r\n      \r\n      Data Cache Limit: This value specifies the maximum size in megabytes (MB) of the XML cache for storing reporting information. The default value is 20 MB. The size applies to the cache in memory. When the limit is reached, the log file will roll over. When a new record is to be added (bottom of the list), one or more of the oldest records (top of the list) will be deleted to make room. A warning will be logged to the Client log and the event log the first time this occurs, and will not be logged again until after the cache has been successfully cleared on transmission and the log has filled up again.\r\n\r\n      Data Block Size: This value specifies the maximum size in bytes to transmit to the server at once on a reporting upload, to avoid permanent transmission failures when the log has reached a significant size. The  default value is 65536. When transmitting report data to the server, one block at a time of application records that is less than or equal to the block size in bytes of XML data will be removed from the cache and sent to the server. Each block will have the general Client data and global package list data prepended, and these will not factor into the block size calculations; the potential exists for an extremely large package list to result in transmission failures over low bandwidth or unreliable connections.\r\n      ","categoryId":"48f508a5-5a2c-4d20-8d89-2d352a209907","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/AppVirtualization/AllowReportingServer","rootDefinitionId":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-appvirtualization#appvirtualization-allowreportingserver"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver_0","options":[{"itemId":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver_reporting_server_url_prompt","required":true},{"dependedOnBy":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver_start_time","required":true},{"dependedOnBy":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver_random_delay","required":true},{"dependedOnBy":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver_interval","required":true},{"dependedOnBy":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver_data_cache_limit","required":true},{"dependedOnBy":"device_vendor_msft_policy_config_appvirtualization_allowreportingserver_data_block_size","required":true}]}]}]