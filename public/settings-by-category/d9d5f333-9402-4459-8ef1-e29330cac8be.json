y","offsetUri":"/Config/VisualStudiov1~Policy~VisualStudio~LiveShareSettings/LiveShareDomainName","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~livesharesettings_livesharedomainname","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~livesharesettings_livesharedomainname_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~livesharesettings_livesharedomainname_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~livesharesettings_livesharedomainname_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~livesharesettings_livesharedomainname_liveshare_domainname_textbox","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov2.1~policy~visualstudio~livesharesettings_disablechat","name":"DisableChat","displayName":"Disable Chat","description":"Prevent the host and guest from using chat within the session.\r\nFor more information, see: https://aka.ms/vsls-policies","categoryId":"d9d5f333-9402-4459-8ef1-e29330cac8be","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov2.1~Policy~VisualStudio~LiveShareSettings/DisableChat","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov2.1~policy~visualstudio~livesharesettings_disablechat","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov2.1~policy~visualstudio~livesharesettings_disablechat_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov2.1~policy~visualstudio~livesharesettings_disablechat_0","displayName":"Disabled","dependedOnBy"