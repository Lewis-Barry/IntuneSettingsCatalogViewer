[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_onedrivengscv6~policy~nucleuslistsync_blockexternallistsync","name":"BlockExternalListSync","displayName":"Blocks syncing of external lists via Lists sync","description":"\r\n      Enabling this setting prevents users at your organization from syncing lists that are shared from other organizations. After the setting is enabled (value 1) on a computer, lists shared from other organizations won't sync. Disable the setting (value 0) to allow your users to sync external lists.\r\n\r\n      ","categoryId":"7fc23813-7a7c-412a-b9bd-eda07e6b1f5d","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/OneDriveNGSCv6~Policy~NucleusListSync/BlockExternalListSync","rootDefinitionId":"device_vendor_msft_policy_config_onedrivengscv6~policy~nucleuslistsync_blockexternallistsync","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_onedrivengscv6~policy~nucleuslistsync_blockexternallistsync_0","options":[{"itemId":"device_vendor_msft_policy_config_onedrivengscv6~policy~nucleuslistsync_blockexternallistsync_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_onedrivengscv6~policy~nucleuslistsync_blockexternallistsync_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_onedrivengscv6~policy~nucleuslistsync_disablelistsync","name":"DisableListSync","displayName":"Disables Lists sync on this device.","description":"\r\n     By default, Lists sync is turned on for users of Microsoft Lists. If you enable this policy, Lists sync will be blocked from running on the device.\r\n\r\n     ","categoryId":"7fc23813-7a7c-412a-b9bd-eda07e6b1f5d","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/OneDriveNGSCv6~Policy~NucleusListSync/DisableListSync","rootDefinitionId":"device_vendor_msft_policy_config_onedrivengscv6~policy~nucleuslistsync_disablelistsync","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_onedrivengscv6~policy~nucleuslistsync_disablelistsync_0","options":[{"itemId":"device_vendor_msft_policy_config_onedrivengscv6~policy~nucleuslistsync_disablelistsync_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_onedrivengscv6~policy~nucleuslistsync_disablelistsync_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_onedrivengscv6~policy~nucleuslistsync_disablelistsyncsilentconfig","name":"DisableListSyncSilentConfig","displayName":"Disables silent configuration of Lists sync on this device.","description":"\r\n       If you enable this setting, users at your organization will not be opted into Lists sync automatically. They will be required to install the Office web extension to use Nucleus.\r\n\r\n      ","categoryId":"7fc23813-7a7c-412a-b9bd-eda07e6b1f5d","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/OneDriveNGSCv6~Policy~NucleusListSync/DisableListSyncSilentConfig","rootDefinitionId":"device_vendor_msft_policy_config_onedrivengscv6~policy~nucleuslistsync_disablelistsyncsilentconfig","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_onedrivengscv6~policy~nucleuslistsync_disablelistsyncsilentconfig_0","options":[{"itemId":"device_vendor_msft_policy_config_onedrivengscv6~policy~nucleuslistsync_disablelistsyncsilentconfig_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_onedrivengscv6~policy~nucleuslistsync_disablelistsyncsilentconfig_1","displayName":"Enabled","dependedOnBy":[]}]}]