yName":"false","dependedOnBy":[]},{"itemId":"vendor_msft_sharedpc_enablesharedpcmode_true","displayName":"true","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"vendor_msft_sharedpc_kioskmodeaumid","name":"KioskModeAUMID","displayName":"Kiosk Mode AUMID","description":"Specifies the AUMID of the app to use with assigned access. If used, this value must be set before the action on the EnableSharedPCMode node is taken.","categoryId":"891d2958-5a8c-479c-aa68-69b1b6c735e1","baseUri":"./Vendor/MSFT/SharedPC","offsetUri":"/KioskModeAUMID","rootDefinitionId":"vendor_msft_sharedpc_kioskmodeaumid","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"vendor_msft_sharedpc_setpowerpolicies","name":"SetPowerPolicies","displayName":"Set Power Policies","description":"Set a list of power policies. If used, this value must be set before the action on the EnableSharedPCMode node is taken.","categoryId":"891d2958-5a8c-479c-aa68-69b1b6c735e1","baseUri":"./Vendor/MSFT/SharedPC","offsetUri":"/SetPowerPolicies","rootDefinitionId":"vendor_msft_sharedpc_setpowerpolicies","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"vendor_msft_sharedpc_setpowerpolicies_false","options":[{"itemId":"vendor_msft_sharedpc_setpowerpolicies_false","displayName":"false","dependedOnBy":[]},{"itemId":"vendor_msft_sharedpc_setpowerpolicies_true","displayName":"true","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"vendor_msft_sharedpc_maxpagefilesizemb","name":"MaxPageFileSizeMB","displayName":"Max Page File Size MB","description":"Maximum size of the paging file in MB. Applies only to systems with less than 32 GB storage and at least 3 GB of RAM. If used, this value must be set before the action on the EnableSharedPCMode node is taken.","categoryId":"891d2958-5a8c-479c-aa68-69b1b6c735e1","baseUri":"./Vendor/MSFT/SharedPC","offsetUri":"/MaxPageFileSizeMB","rootDefinitionId":"vendor_msft_sharedpc_maxpagefilesizemb","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/SharedPC-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"vendor_msft_sharedpc_disklevelcaching","name":"DiskLevelCaching","displayName":"Disk Level Caching","description":"Stop deleting accounts when available disk space reaches this threshold, given as percent of total disk capacity. If used, this value must be set before the action on the EnableSharedPCMode node is taken.","categoryId":"891d2958-5a8c-479c-aa68-69b1b6c735e1","baseUri":"./Vendor/MSFT/SharedPC","offsetUri":"/DiskLevelCaching","rootDefinitionId":"vendor_msft_sharedpc_disklevelcaching","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"vendor_msft_sharedpc_setedupolicies","name":"SetEduPolicies","displayName":"Set Edu Policies","description":"Set a list of EDU policies.","categoryId":"891d2958-5a8c-479c-aa68-69b1b6c735e1","baseUri":"./Vendor/MSFT/SharedPC","offsetUri":"/SetEduPolicies","rootDefinitionId":"vendor_msft_sharedpc_setedupolicies","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"vendor_msft_sharedpc_setedupolicies_false","options":[{"itemId":"vendor_msft_sharedpc_setedupolicies_false","displayName":"false","dependedOnBy":[]},{"itemId":"vendor_msft_sharedpc_setedupolicies_true","displayName":"true","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"vendor_msft_sharedpc_maintenancestarttime","name":"MaintenanceStartTime","displayName":"Maintenance Start Time","description":"Daily start time of maintenance hour. Given in minutes from midnight. Default is 0 (12am).  If used, this value must be set before the action on the EnableSharedPCMode node is taken.","categoryId":"891d2958-5a8c-479c-aa68-69b1b6c735e1","baseUri":"./Vendor/MSFT/SharedPC","offsetUri":"/MaintenanceStartTime","rootDefinitionId":"vendor_msft_sharedpc_maintenancestarttime","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"vendor_msft_sharedpc_diskleveldeletion","name":"DiskLevelDeletion","displayName":"Disk Level Deletion","description":"Accounts will start being deleted when available disk space falls below this threshold, given as percent of total disk capacity. Accounts that have been inactive the longest will be deleted first. If used, this value must be set before the action on the EnableSharedPCMode node is taken.","categoryId":"891d2958-5a8c-479c-aa68-69b1b6c735e1","baseUri":"./Vendor/MSFT/SharedPC","offsetUri":"/DiskLevelDeletion","rootDefinitionId":"vendor_msft_sharedpc_diskleveldeletion","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"vendor_msft_sharedpc_signinonresume","name":"SignInOnResume","displayName":"Sign In On Resume","description":"Require signing in on waking up from sleep. If used, this value must be set before the action on the EnableSharedPCMode node is taken.","categoryId":"891d2958-5a8c-479c-aa68-69b1b6c735e1","baseUri":"./Vendor/MSFT/SharedPC","offsetUri":"/SignInOnResume","rootDefinitionId":"vendor_msft_sharedpc_signinonresume","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"vendor_msft_sharedpc_signinonresume_