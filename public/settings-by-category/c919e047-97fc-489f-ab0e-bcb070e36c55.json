[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_remotemanagement_trustedhosts","name":"TrustedHosts","displayName":"Trusted Hosts","description":"This policy setting allows you to manage whether the Windows Remote Management (WinRM) client uses the list specified in TrustedHostsList to determine if the destination host is a trusted entity.\r\n\r\nIf you enable this policy setting, the WinRM client uses the list specified in TrustedHostsList to determine if the destination host is a trusted entity. The WinRM client uses this list when neither HTTPS nor Kerberos are used to authenticate the identity of the host.\r\n\r\nIf you disable or do not configure this policy setting and the WinRM client needs to use the list of trusted hosts, you must configure the list of trusted hosts locally on each computer.","categoryId":"c919e047-97fc-489f-ab0e-bcb070e36c55","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/RemoteManagement/TrustedHosts","rootDefinitionId":"device_vendor_msft_policy_config_remotemanagement_trustedhosts","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-remotemanagement#remotemanagement-trustedhosts"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_remotemanagement_trustedhosts_0","options":[{"itemId":"device_vendor_msft_policy_config_remotemanagement_trustedhosts_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_remotemanagement_trustedhosts_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_remotemanagement_trustedhosts_trustedhosts_list","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_remotemanagement_disallownegotiateauthenticationclient","name":"DisallowNegotiate_2","