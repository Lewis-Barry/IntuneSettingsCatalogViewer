ervices Code Point (DSCP) value for packets with the Guaranteed service type (ServiceTypeGuaranteed). The Packet Scheduler inserts the corresponding DSCP value in the IP header of the packets.\r\n\r\nThis setting applies only to packets that do not conform to the flow specification.\r\n\r\nIf you enable this setting, you can change the default DSCP value associated with the Guaranteed service type.\r\n\r\nIf you disable this setting, the system uses the default DSCP value of 0.\r\n\r\nImportant: If the DSCP value for this service type is specified in the registry for a particular network adapter, this setting is ignored when configuring that network adapter.\r\n ","categoryId":"82d20a08-90b8-4e6d-940a-5574844d1b26","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_QOS/QosServiceTypeGuaranteed_NC","rootDefinitionId":"device_vendor_msft_policy_config_admx_qos_qosservicetypeguaranteed_nc","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-qos#admx-qos-qosservicetypeguaranteed-nc"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_qos_qosservicetypeguaranteed_nc_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_qos_qosservicetypeguaranteed_nc_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_qos_qosservicetypeguaranteed_nc_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_qos_qosservicetypeguaranteed_nc_qosdscpvalue","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_qos_qosservicetypequalitative_nc_qosdscpvalue","name":"QosDSCPValue","displayName":"DSCP value: (Device)","categoryId":"82d20a08-90b8-4e6d-940a-5574844d1b26","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_QOS/QosServiceTypeQualitative_NC","rootDefinitionId":"device_vendor_msft_policy_config_admx_qos_qosservicetypequalitative_nc","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_qos_qosservicetypequalitative_nc","name":"QosServiceTypeQualitative_NC","displayName":"Qualitative service type","description":"Specifies an alternate Layer-3 Differentiated Services Code Point (DSCP) value for packets with the Qualitative service type (ServiceTypeQualitative). The Packet Scheduler inserts the corresponding DSCP value in the IP header of the packets.\r\n\r\nThis setting applies only to packets that do not conform to the flow specification.\r\n\r\nIf you enable this setting, you can change the default DSCP value associated with the Qualitative service type.\r\n\r\nIf you disable this setting, the system uses the default DSCP value of 0.\r\n\r\nImportant: If the DSCP value for this service type is specified in the registry for a particular network adapter, this setting is ignored when configuring that network adapter.\r\n ","categoryId":"82d20a08-90b8-4e6d-940a-5574844d1b26","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_QOS/QosServiceTypeQualitative_NC","rootDefinitionId":"device_vendor_msft_policy_config_admx_qos_qosservicetypequalitative_nc","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-qos#admx-qos-qosservicetypequalitative-nc"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_qos_qosservicetypequalitative_nc_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_qos_qosservicetypequalitative_nc_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_qos_qosservicetypequalitative_nc_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_qos_qosservicetypequalitative_nc_qosdscpvalue","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_qos_qosservicetypeguaranteed_nc_qosdscpvalue","name":"QosDSCPValue","displayName":"DSCP value: (Device)","categoryId":"82d20a08-90b8-4e6d-940a-5574844d1b26","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_QOS/QosServiceTypeGuaranteed_NC","rootDefinitionId":"device_vendor_msft_policy_config_admx_qos_qosservicetypeguaranteed_nc","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_qos_qosservicetypebesteffort_nc","name":"QosServiceTypeBestEffort_NC","displayName":"Best effort service type","description":"Specifies an alternate Layer-3 Differentiated Services Code Point (DSCP) value for packets with the Best Effort service type (ServiceTypeBestEffort). The Packet Scheduler inserts the corresponding DSCP value in the IP header of the packets.\r\n\r\nThis setting applies only to packets that do not conform to the flow specification.\r\n\r\nIf you enable this setting, you can change the default DSCP value associated with the Best Effort service type.\r\n\r\nIf you disable this setting, the system uses the default DSCP value of 0.\r\n\r\nImportant: If the DSCP value for this service type is specified in the registry for a particular network adapter, this setting is ignored when configuring that network adapter.\r\n ","categoryId":"82d20a08-90b8-4e6d-940a-5574844d1b26","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_QOS/QosServiceTypeBestEffort_NC","rootDefinitionId":"device_vendor_msft_policy_config_admx_qos_qosservicetypebesteffort_nc","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-managemen