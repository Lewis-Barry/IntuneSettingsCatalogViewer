 be removed.\r\n\r\nIf you disable this setting the Microsoft Store source for the Windows Package Manager will not be available.","categoryId":"70063d93-03f0-462e-9943-b0241b88d54d","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/DesktopAppInstaller/EnableMicrosoftStoreSource","rootDefinitionId":"device_vendor_msft_policy_config_desktopappinstaller_enablemicrosoftstoresource","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-desktopappinstaller#desktopappinstaller-enablemicrosoftstoresource"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_desktopappinstaller_enablemicrosoftstoresource_0","options":[{"itemId":"device_vendor_msft_policy_config_desktopappinstaller_enablemicrosoftstoresource_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_desktopappinstaller_enablemicrosoftstoresource_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_desktopappinstaller_enablewindowspackagemanagercommandlineinterfaces","name":"EnableWindowsPackageManagerCommandLineInterfaces","displayName":"Enable Windows Package Manager command line interfaces","description":"This policy determines if a user can perform an action using the Windows Package Manager through a command line interface (WinGet CLI, or WinGet PowerShell).\r\n\r\nIf you disable this policy, users will not be able execute the Windows Package Manager CLI, and PowerShell cmdlets.\r\n\r\nIf you enable, or do not configuring this policy, users will be able to execute the Windows Package Manager CLI commands, and PowerShell cmdlets. (Provided “Enable App Installer” policy is not disabled).\r\n\r\nThis policy does not override the “Enable App Installer” policy.","categoryId":"70063d93-03f0-462e-9943-b0241b88d54d","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/DesktopAppInstaller/EnableWindowsPackageManagerCommandLineInterfaces","rootDefinitionId":"device_vendor_msft_policy_config_desktopappinstaller_enablewindowspackagemanagercommandlineinterfaces","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-desktopappinstaller#desktopappinstaller-enablewindowspackagemanagercommandlineinterfaces"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_desktopappinstaller_enablewindowspackagemanagercommandlineinterfaces_0","options":[{"itemId":"device_vendor_msft_policy_config_desktopappinstaller_enablewindowspackagemanagercommandlineinterfaces_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_desktopappinstaller_enablewindowspackagemanagercommandlineinterfaces_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_desktopappinstaller_enableappinstaller","name":"EnableAppInstaller","displayName":"Enable App Installer","description":"This policy controls whether the Windows Package Manager can be used by users.\r\n\r\nIf you enable or do not configure this setting, users will be able to use the Windows Package Manager.\r\n\r\nIf you disable this setting, users will not be able to use the Windows Package Manager.","categoryId":"70063d93-03f0-462e-9943-b0241b88d54d","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/DesktopAppInstaller/EnableAppInstaller","rootDefinitionId":"device_vendor_msft_policy_config_desktopappinstaller_enableappinstaller","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-desktopappinstaller#desktopappinstaller-enableappinstaller"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_desktopappinstaller_enableappinstaller_0","options":[{"itemId":"device_vendor_msft_policy_config_desktopappinstaller_enableappinstaller_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_desktopappinstaller_enableappinstaller_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_desktopappinstaller_enablesettings","name":"EnableSettings","displayName":"Enable App Installer Settings","description":"This policy controls whether users can change their settings.\r\n\r\nIf you enable or do not configure this setting, users will be able to change settings for the Windows Package Manager.\r\n\r\nIf you disable this setting, users will not be able to change settings for the Windows Package Manager.","categoryId":"70063d93-03f0-462e-9943-b0241b88d54d","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/DesktopAppInstaller/EnableSettings","rootDefinitionId":"device_vendor_msft_policy_config_desktopappinstaller_enablesettings","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-desktopappinstaller#desktopappinstaller-enablesettings"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_desktopappinstaller_enablesettings_0","options":[{"itemId":"device_vendor_msft_policy_config_desktopappinstaller_enablesettings_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_desktopappinstaller_enablesettings_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_desktopappinstaller_enablemsappinstallerprotocol","name":"EnableMSAppInstallerProtocol","displayName":"Enable App Installer ms-appinstaller protocol","description":"This policy controls whether users can 