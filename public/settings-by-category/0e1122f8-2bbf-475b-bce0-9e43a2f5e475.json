ofweek_7","displayName":"Saturday","dependedOnBy":[]},{"itemId":"linux_mdatp_managed_antivirusengine_scheduledscan_dayofweek_8","displayName":"Daily","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"linux_mdatp_managed_antivirusengine_scheduledscan_checkfordefinitionsupdate","name":"scheduledScan/checkForDefinitionsUpdate","displayName":"Schedule Signature Updates Before Running Scan","description":"This policy setting allows you to manage whether a check for new security intelligence definitions will occur before running a schedule scan. If you enable this setting, a check for new definitions will occur before running a scan. If you disable this setting or do not configure this setting, the scan will start using the existing definitions.","categoryId":"0e1122f8-2bbf-475b-bce0-9e43a2f5e475","baseUri":"PayloadContent/scheduledScan","offsetUri":"checkForDefinitionsUpdate","rootDefinitionId":"linux_mdatp_managed_antivirusengine_scheduledscan_checkfordefinitionsupdate","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/microsoft-365/security/defender-endpoint/linux-preferences#scheduled-scan"],"applicability":{"platform":"linux","technologies":"microsoftSense"},"defaultOptionId":"linux_mdatp_managed_antivirusengine_scheduledscan_checkfordefinitionsupdate_false","options":[{"itemId":"linux_mdatp_managed_antivirusengine_scheduledscan_checkfordefinitionsupdate_false","displayName":"Disabled","dependedOnBy":[]},{"itemId":"linux_mdatp_managed_antivirusengine_scheduledscan_checkfordefinitionsupdate_true","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"linux_mdatp_managed_antivirusengine_scheduledscan_runscanwhenidle","name":"scheduledScan/runScanWhenIdle","displayName":"Run scan when device is idle","description":"When enabled, the scheduled scan will only start when the device is considered idle- meaning minimal CPU usage and no active user sessions. This helps reduce performance impact during peak usage hours. If the device remains busy, the scan will be deferred until idle conditions are met.","categoryId":"0e1122f8-2bbf-475b-bce0-9e43a2f5e475","baseUri":"PayloadContent/scheduledScan","offsetUri":"runScanWhenIdle","rootDefinitionId":"linux_mdatp_managed_antivirusengine_scheduledscan_runscanwhenidle","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/microsoft-365/security/defender-endpoint/linux-preferences#scheduled-scan"],"applicability":{"platform":"linux","technologies":"microsoftSense"},"defaultOptionId":"linux_mdatp_managed_antivirusengine_scheduledscan_runscanwhenidle_false","options":[{"itemId":"linux_mdatp_managed_antivirusengine_scheduledscan_runscanwhenidle_false","displayName":"Disabled","dependedOnBy":[]},{"itemId":"linux_mdatp_managed_antivirusengine_scheduledscan_runscanwhenidle_true","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"linux_mdatp_managed_antivirusengine_scheduledscan_lowpriorityscheduledscan","name":"scheduledScan/lowPriorityScheduledScan","displayName":"Run with low CPU priority","description":"This policy setting allows you to enable or disable low CPU priority for scheduled scans. If you enable this setting, low CPU priority will be used during scheduled scans. If you disable or do not configure this setting, not changes will be made to CPU priority for scheduled scans.","categoryId":"0e1122f8-2bbf-475b-bce0-9e43a2f5e475","baseUri":"PayloadContent/scheduledScan","offsetUri":"lowPriorityScheduledScan","rootDefinitionId":"linux_mdatp_managed_antivirusengine_scheduledscan_lowpriorityscheduledscan","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/microsoft-365/security/defender-endpoint/linux-preferences#scheduled-scan"],"applicability":{"platform":"linux","technologies":"microsoftSense"},"defaultOptionId":"linux_mdatp_managed_antivirusengine_scheduledscan_lowpriorityscheduledscan_false","options":[{"itemId":"linux_mdatp_managed_antivirusengine_scheduledscan_lowpriorityscheduledscan_false","displayName":"Disabled","dependedOnBy":[]},{"itemId":"linux_mdatp_managed_antivirusengine_scheduledscan_lowpriorityscheduledscan_true","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"linux_mdatp_managed_antivirusengine_scheduledscan_timeofday","name":"scheduledScan/dailyConfiguration/timeOfDay","displayName":"Daily Schedule scan time","description":"Selects the time of day that the Defender daily scan should run. For example, a value of 0=12:00AM, a value of 60=1:00AM, a value of 120=2:00, and so on, up to a value of 1380=11:00PM. The default value is 120.","categoryId":"0e1122f8-2bbf-475b-bce0-9e43a2f5e475","baseUri":"PayloadContent/scheduledScan","offsetUri":"dailyConfiguration/timeOfDay","rootDefinitionId":"linux_mdatp_managed_antivirusengine_scheduledscan_timeofday","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/microsoft-365/security/defender-endpoint/linux-preferences#scheduled-scan"],"applicability":{"platform":"linux","technologies":"microsoftSense"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"linux_mdatp_managed_antivirusengine_scheduledscan_ignoreexclusions","name":"scheduledScan/ignoreExclusions","displayName":"Ignore Exclusions","description":"This setting allows you to select whether to ignore exclusions set on the client while running schedule scans","categoryId":"0e1122f8-2bbf-475b-bce0-9e43a2f5e475","baseUri":"PayloadContent/scheduledScan","offsetUri":"ignoreExclusions","rootDefinitionId":"linux_mdatp_managed_antivirusengine_scheduledscan_ignoreexclusions","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/microsoft-365/security/defender-endpoint/linux-preferences#scheduled-scan"],"applicability":{"platform":"linux","technologies":"microsoftSense"},"defaultOptionId":"linux_mdatp_managed_antivirusengine_scheduledscan_ignoreexclusions_false","options":[{"itemId":"linux_mdatp_managed_antivirusengine_scheduledscan_ignoreexclusions_false","displayName":"Disable","dependedOnBy":[]},{"itemId":"linux_mdatp_managed_antivirusengine_scheduledscan_ignoreexclusions_true","displayName":"Enable","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"linux_mdatp_managed_antivirusengine_scheduledscan_interval","name":"scheduledScan/interval","displayName":"Daily Schedule quick scan interval (hours)","description":"This setting is only applicable if you have selcted scan type as quick scan. Select the interval at which you want to run quick scans. Quick scans can be run multiple times a day.  0 (never), every 1 (hour) to every 24 (hours, one scan per day).","categoryId":"0e1122f8-2bbf-475b-bce0-9e43a2f5e475","baseUri":"PayloadContent/scheduledScan","offsetUri":"dailyConfiguration/interval","rootDefinitionId":"linux_mdatp_managed_antivirusengine_scheduledscan_interval","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/microsoft-365/security/defender-endpoint/linux-preferences#scheduled-scan"],"applicability":{"platform":"linux","technologies":"microsoftSense"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"linux_mdatp_managed_antivirusengine_scheduledscan_randomizescanstarttime","name":"scheduledScan/randomizeScanStartTime","displayName":"Randomize scan start time","description":"Only applicable for daily quick scans or weekly quick/full scans. Randomize the start time of the scan by up to specified number of hours. For example, if a scan is scheduled for 2 p.m and randomizeScanStartTime is set to 2, the scan commences at a random time between 2 p.m and 4 p.m. Set to 0 to disable randomization.","categoryId":"0e1122f8-2bbf-475b-bce0-9e43a2f5e475","baseUr