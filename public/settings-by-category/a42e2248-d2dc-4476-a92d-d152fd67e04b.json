[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSettingGroupCollectionDefinition","id":"audioaccessory_temporarypairing","name":"TemporaryPairing","displayName":"Temporary Pairing","description":"A dictionary that describes audio accessory temporary pairing behavior. The device enables temporary pairing when this key is present and the `Disabled` key isn't `false`. The device doesn't synchronize pairing information with iCloud when temporary pairing is active.","categoryId":"a42e2248-d2dc-4476-a92d-d152fd67e04b","offsetUri":"TemporaryPairing","rootDefinitionId":"audioaccessory_audioaccessory","uxBehavior":"default","applicability":{"platform":"iOS","technologies":"appleRemoteManagement"},"dependedOnBy":[{"dependedOnBy":"audioaccessory_temporarypairing_disabled","required":false},{"dependedOnBy":"audioaccessory_temporarypairing_configuration","required":false}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"audioaccessory_temporarypairing_configuration_unpairingtime_hour","name":"TemporaryPairing_Configuration_UnpairingTime_Hour","displayName":"Hour","description":"The local time hour (24-hour clock) when the device automatically unpairs temporarily paired audio accessories. Required when setting the `Policy` key to `Hour`.","categoryId":"a42e2248-d2dc-4476-a92d-d152fd67e04b","offsetUri":"TemporaryPairing/Configuration/UnpairingTime/Hour","rootDefinitionId":"audioaccessory_audioaccessory","uxBehavior":"default","applicability":{"platform":"iOS","technologies":"appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"audioaccessory_temporarypairing_configuration_unpairingtime_policy","name":"TemporaryPairing_Configuration_UnpairingTime_Policy","displayName":"Policy","description":"A string that specifies the device's unpairing policy.\n- `None`: The device doesn't automatically unpair. Use this only with a return to service devic