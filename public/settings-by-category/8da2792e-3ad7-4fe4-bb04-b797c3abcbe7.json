[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_deviceinstallation_deviceinstall_systemrestore","name":"DeviceInstall_SystemRestore","displayName":"Prevent creation of a system restore point during device activity that would normally prompt creation of a restore point","description":"This policy setting allows you to prevent Windows from creating a system restore point during device activity that would normally prompt Windows to create a system restore point. Windows normally creates restore points for certain driver activity, such as the installation of an unsigned driver. A system restore point enables you to more easily restore your system to its state before the activity. \r\n\r\nIf you enable this policy setting, Windows does not create a system restore point when one would normally be created.\r\n\r\nIf you disable or do not configure this policy setting, Windows creates a system restore point as it normally would.\r\n ","categoryId":"8da2792e-3ad7-4fe4-bb04-b797c3abcbe7","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_DeviceInstallation/DeviceInstall_SystemRestore","rootDefinitionId":"device_vendor_msft_policy_config_admx_deviceinstallation_deviceinstall_systemrestore","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-deviceinstallation#admx-deviceinstallation-deviceinstall-systemrestore"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_deviceinstallation_deviceinstall_systemrestore_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_deviceinstallation_deviceinstall_systemrestore_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_deviceinstallation_deviceinstall_systemrestore_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_deviceinstallation_deviceinstall_installtimeout","name":"DeviceInstall_InstallTimeout","displayName":"Configure device installation time-out","description":"This policy setting allows you to configure the number of seconds Windows waits for a device installation task to complete. \r\n\r\nIf you enable this policy setting, Windows waits for the number of seconds you specify before terminating the installation.\r\n\r\nIf you disable or do not configure this policy setting, Windows waits 240 seconds for a device installation task to complete before terminating the installation.\r\n ","categoryId":"8da2792e-3ad7-4fe4-bb04-b797c3abcbe7","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_DeviceInstallation/DeviceInstall_InstallTimeout","rootDefinitionId":"device_vendor_msft_policy_config_admx_deviceinstallation_deviceinstall_installtimeout","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-deviceinstallation#admx-deviceinstallation-deviceinstall-installtimeout"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_deviceinstallation_deviceinstall_installtimeout_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_deviceinstallation_deviceinstall_installtimeout_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_deviceinstallation_deviceinstall_installtimeout_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_deviceinstallation_deviceinstall_installtimeout_deviceinstall_installtimeout_time","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_deviceinstallation_deviceinstall_installtimeout_deviceinstall_installtimeout_time","name":"DeviceInstall_InstallTimeout_Time","displayName":"Device Installation Timeout (in seconds)","categoryId":"8da2792e-3ad7-4fe4-bb04-b797c3abcbe7","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_DeviceInstallation/DeviceInstall_InstallTimeout","rootDefinitionId":"device_vendor_msft_policy_config_admx_deviceinstallation_deviceinstall_installtimeout","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]}]