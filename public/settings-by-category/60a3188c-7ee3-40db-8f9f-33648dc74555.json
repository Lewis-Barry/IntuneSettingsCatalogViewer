[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_wininit_disablenamedpipeshutdownpolicydescription","name":"DisableNamedPipeShutdownPolicyDescription","displayName":"Turn off legacy remote shutdown interface","description":"This policy setting controls the legacy remote shutdown interface (named pipe). The named pipe remote shutdown interface is needed in order to shutdown this system from a remote Windows XP or Windows Server 2003 system.\r\n\r\nIf you enable this policy setting, the system does not create the named pipe remote shutdown interface.\r\n\r\nIf you disable or do not configure this policy setting, the system creates the named pipe remote shutdown interface.\r\n ","categoryId":"60a3188c-7ee3-40db-8f9f-33648dc74555","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_WinInit/DisableNamedPipeShutdownPolicyDescription","rootDefinitionId":"device_vendor_msft_policy_config_admx_wininit_disablenamedpipeshutdownpolicydescription","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-wininit#admx-wininit-disablenamedpipeshutdownpolicydescription"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_wininit_disablenamedpipeshutdownpolicydescription_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_wininit_disablenamedpipeshutdownpolicydescription_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_wininit_disablenamedpipeshutdownpolicydescription_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_wininit_shutdowntimeouthungsessionsdescription_shutdownsessiontimeout_time","name":"ShutdownSessionTimeout_Time","displayName":"Hung session timeout in Minutes: (Device)","categoryId":"60a3188c-7ee3-40db-8f9f-33648dc74555","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_WinInit/ShutdownTimeoutHungSessionsDescription","rootDefinitionId":"device_vendor_msft_policy_config_admx_wininit_shutdowntimeouthungsessionsdescription","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_wininit_shutdowntimeouthungsessionsdescription","name":"ShutdownTimeoutHungSessionsDescription","displayName":"Timeout for hung logon sessions during shutdown","description":"This policy setting configures the number of minutes the system waits for the hung logon sessions before proceeding with the system shutdown.\r\n\r\nIf you enable this policy setting, the system waits for the hung logon sessions for the number of minutes specified.\r\n\r\nIf you disable or do not configure this policy setting, the default timeout value is 3 minutes for workstations and 15 minutes for servers.\r\n ","categoryId":"60a3188c-7ee3-40db-8f9f-33648dc74555","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_WinInit/ShutdownTimeoutHungSessionsDescription","rootDefinitionId":"device_vendor_msft_policy_config_admx_wininit_shutdowntimeouthungsessionsdescription","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-wininit#admx-wininit-shutdowntimeouthungsessionsdescription"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_wininit_shutdowntimeouthungsessionsdescription_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_wininit_shutdowntimeouthungsessionsdescription_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_wininit_shutdowntimeouthungsessionsdescription_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_wininit_shutdowntimeouthungsessionsdescription_shutdownsessiontimeout_time","required":true}]}]}]