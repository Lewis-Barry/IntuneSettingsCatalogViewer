oxy script","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxymode_part_proxymode_fixed_servers","displayName":"Use fixed proxy servers","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxymode_part_proxymode_system","displayName":"Use system proxy settings","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxyserver","name":"Pol_ProxyServer","displayName":"Address or URL of proxy server","description":"Allows you to specify the URL of the proxy server for Microsoft Edge Update to use.\r\n\r\n  If you enable this policy, you can set the proxy server URL used by Microsoft Edge Update in your organization.\r\n\r\n  This policy is applied only if you have selected manual proxy settings in the 'Choose how to specify proxy server settings' policy.\r\n\r\n  Don't configure this policy if you have selected a proxy setting other than manual in the 'Choose how to specify proxy server settings' policy.","categoryId":"ff543267-540e-4e37-a1e9-daf6a5e16ba7","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/update~Policy~Cat_Google~Cat_GoogleUpdate~Cat_ProxyServer/Pol_ProxyServer","rootDefinitionId":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxyserver","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxyserver_0","options":[{"itemId":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxyserver_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxyserver_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxyserver_part_proxyserver","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxymode","name":"Pol_ProxyMode","displayName":"Choose how to specify proxy server settings","description":"Allows you to specify the proxy server settings that are used by Microsoft Edge Update.\r\n\r\n  If you enable this policy, you can choose between the following proxy server options:\r\n   - If you choose to never use a proxy server and always connect directly, all other options are ignored.\r\n   - If you choose to use system proxy settings or auto-detect the proxy server, all other options are ignored.\r\n   - If you choose fixed server proxy mode, you can specify further options in 'Address or URL of proxy server'.\r\n   - If you choose to use a .pac proxy script, you must specify the URL for the script in 'URL to a proxy .pac file'.\r\n\r\n  If you enable this policy, users in your organization can't change the proxy settings in Microsoft Edge Update.\r\n\r\n  If you disable or don't configure this policy, no proxy server settings are configured, but users in your organization can choose their own proxy settings for Microsoft Edge Update.","categoryId":"ff543267-540e-4e37-a1e9-daf6a5e16ba7","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/update~Policy~Cat_Google~Cat_GoogleUpdate~Cat_ProxyServer/Pol_ProxyMode","rootDefinitionId":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxymode","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxymode_0","options":[{"itemId":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxymode_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxymode_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxymode_part_proxymode","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxyserver_part_proxyserver","name":"Part_ProxyServer","displayName":"Address or URL of proxy server (Device)","categoryId":"ff543267-540e-4e37-a1e9-daf6a5e16ba7","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/update~Policy~Cat_Google~Cat_GoogleUpdate~Cat_ProxyServer/Pol_ProxyServer","rootDefinitionId":"device_vendor_msft_policy_config_update~policy~cat_google~cat_googleupdate~cat_proxyserver_pol_proxyserver","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]}]