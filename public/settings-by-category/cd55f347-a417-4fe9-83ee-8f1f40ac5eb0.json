anager"},"defaultOptionId":"device_vendor_msft_windowsdefenderapplicationguard_installwindowsdefenderapplicationguard_install","options":[{"itemId":"device_vendor_msft_windowsdefenderapplicationguard_installwindowsdefenderapplicationguard_install","displayName":"Install - Will initiate feature install","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_windowsdefenderapplicationguard_settings_allowwindowsdefenderapplicationguard","name":"AllowWindowsDefenderApplicationGuard","displayName":"Turn on Microsoft Defender Application Guard","description":"This policy setting enables application isolation through Microsoft Defender Application Guard.","categoryId":"cd55f347-a417-4fe9-83ee-8f1f40ac5eb0","baseUri":"./Device/Vendor/MSFT/WindowsDefenderApplicationGuard","offsetUri":"/Settings/AllowWindowsDefenderApplicationGuard","rootDefinitionId":"device_vendor_msft_windowsdefenderapplicationguard_settings_allowwindowsdefenderapplicationguard","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/WindowsDefenderApplicationGuard-csp/"],"applicability":{"platform":"windows10","technologies":"mdm,configManager"},"options":[{"itemId":"device_vendor_msft_windowsdefenderapplicationguard_settings_allowwindowsdefenderapplicationguard_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_windowsdefenderapplicationguard_settings_allowwindowsdefenderapplicationguard_1","displayName":"Enabled for Microsoft Edge ONLY","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_windowsdefenderapplicationguard_settings_clipboardfiletype","required":false},{"dependedOnBy":"device_vendor_msft_windowsdefenderapplicationguard_settings_clipboardsettings","required":false},{"dependedOnBy":"device_vendor_msft_windowsdefenderapplicationguard_settings_printingsettings","required":false},{"dependedOnBy":"device_vendor_msft_windowsdefenderapplicationguard_settings_al