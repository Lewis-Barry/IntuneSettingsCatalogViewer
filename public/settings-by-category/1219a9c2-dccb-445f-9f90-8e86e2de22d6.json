MaxConcurrentUsers","displayName":"MaxConcurrentUsers (Device)","categoryId":"1219a9c2-dccb-445f-9f90-8e86e2de22d6","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/RemoteShell/MaxConcurrentUsers","rootDefinitionId":"device_vendor_msft_policy_config_remoteshell_maxconcurrentusers","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_remoteshell_maxconcurrentusers","name":"MaxConcurrentUsers","displayName":"MaxConcurrentUsers","description":"This policy setting configures the maximum number of users able to concurrently perform remote shell operations on the system.\r\n\r\nThe value can be any  number from 1 to 100.\r\n\r\nIf you enable this policy setting, the new shell connections are rejected if they exceed the specified limit.\r\n\r\nIf you disable or do not configure this policy setting, the default number is five users.","categoryId":"1219a9c2-dccb-445f-9f90-8e86e2de22d6","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/RemoteShell/MaxConcurrentUsers","rootDefinitionId":"device_vendor_msft_policy_config_remoteshell_maxconcurrentusers","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-remoteshell#remoteshell-maxconcurrentusers"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_remoteshell_maxconcurrentusers_0","options":[{"itemId":"device_vendor_msft_policy_config_remoteshell_maxconcurrentusers_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_remoteshell_maxconcurrentusers_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_remoteshell_maxconcurrentusers_maxconcurrentusers","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettin