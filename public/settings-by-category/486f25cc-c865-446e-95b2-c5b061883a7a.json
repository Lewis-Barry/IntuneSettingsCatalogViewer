[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_teredo_refresh_rate_teredorefreshratebox","name":"TeredoRefreshRateBox","displayName":"Seconds:","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/Teredo_Refresh_Rate","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_refresh_rate","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_teredo_default_qualified","name":"Teredo_Default_Qualified","displayName":"Set Teredo Default Qualified","description":"This policy setting allows you to set Teredo to be ready to communicate, a process referred to as qualification. By default, Teredo enters a dormant state when not in use. The qualification process brings it out of a dormant state.\r\n\r\nIf you disable or do not configure this policy setting, the local host setting is used.\r\n\r\nThis policy setting contains only one state:\r\n\r\nPolicy Enabled State: If Default Qualified is enabled, Teredo will attempt qualification immediately and remain qualified if the qualification process succeeds.\r\n\r\n ","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/Teredo_Default_Qualified","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_default_qualified","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-tcpip#admx-tcpip-teredo-default-qualified"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_default_qualified_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_teredo_default_qualified_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_teredo_default_qualified_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_tcpip_teredo_default_qualified_stateselect","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name_resolution_interval","name":"6to4_Router_Name_Resolution_Interval","displayName":"Set 6to4 Relay Name Resolution Interval","description":"This policy setting allows you to specify the interval at which the relay name is resolved. The 6to4 relay name resolution interval setting has no effect if 6to4 connectivity is not available on the host.\r\n\r\nIf you enable this policy setting, you can specify the value for the duration at which the relay name is resolved periodically.\r\n\r\nIf you disable or do not configure this policy setting, the local host setting is used.\r\n\r\n\r\n ","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/6to4_Router_Name_Resolution_Interval","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name_resolution_interval","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-tcpip#admx-tcpip-6to4-router-name-resolution-interval"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name_resolution_interval_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name_resolution_interval_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name_resolution_interval_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name_resolution_interval_routernameresolutionintervalbox","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_isatap_router_name","name":"ISATAP_Router_Name","displayName":"Set ISATAP Router Name","description":"This policy setting allows you to specify a router name or Internet Protocol version 4 (IPv4) address for an ISATAP router.\r\n\r\nIf you enable this policy setting, you can specify a router name or IPv4 address for an ISATAP router. If you enter an IPv4 address of the ISATAP router in the text box, DNS services are not required.\r\n\r\nIf you disable or do not configure this policy setting, the local host setting is used.\r\n\r\n\r\n ","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/ISATAP_Router_Name","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_isatap_router_name","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-tcpip#admx-tcpip-isatap-router-name"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_isatap_router_name_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_isatap_router_name_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_isatap_router_name_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_tcpip_isatap_router_name_routernamebox","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_isatap_router_name_routernamebox","name":"RouterNameBox","displayName":"Enter a router or relay name:","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/ISATAP_Router_Name","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_isatap_router_name","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_iphttps_clientstate_stateselect","name":"StateSelect","displayName":"Select Interface state from the following options:","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/IPHTTPS_ClientState","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_iphttps_clientstate","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_iphttps_clientstate_stateselect_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_iphttps_clientstate_stateselect_0","displayName":"Default State","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_iphttps_clientstate_stateselect_2","displayName":"Enabled State","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_iphttps_clientstate_stateselect_3","displayName":"Disabled State","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_teredo_server_name","name":"Teredo_Server_Name","displayName":"Set Teredo Server Name","description":"This policy setting allows you to specify the name of the Teredo server. This server name will be used on the Teredo client computer where this policy setting is applied.\r\n\r\nIf you enable this policy setting, you can specify a Teredo server name that applies to a Teredo client.\r\n\r\nIf you disable or do not configure this policy setting, the local settings on the computer are used to determine the Teredo server name.\r\n\r\n\r\n ","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/Teredo_Server_Name","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_server_name","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-tcpip#admx-tcpip-teredo-server-name"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_server_name_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_teredo_server_name_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_teredo_server_name_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_tcpip_teredo_server_name_teredoservernamebox","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name_resolution_interval_routernameresolutionintervalbox","name":"RouterNameResolutionIntervalBox","displayName":"Minutes:","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/6to4_Router_Name_Resolution_Interval","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name_resolution_interval","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_teredo_client_port_teredoclientportbox","name":"TeredoClientPortBox","displayName":"The range is 0 to 65535. Default (recommended) is 0 which is to let the local system pick the port.","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/Teredo_Client_Port","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_client_port","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_iphttps_clientstate_iphttpsclienturlbox","name":"IPHTTPSClientUrlBox","displayName":"Enter the IPHTTPS Url:","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/IPHTTPS_ClientState","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_iphttps_clientstate","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_isatap_state","name":"ISATAP_State","displayName":"Set ISATAP State","description":"This policy setting allows you to configure Intra-Site Automatic Tunnel Addressing Protocol (ISATAP), an address-to-router and host-to-host, host-to-router and router-to-host automatic tunneling technology that is used to provide unicast IPv6 connectivity between IPv6 hosts across an IPv4 intranet.\r\n\r\nIf you disable or do not configure this policy setting, the local host setting is used.\r\n\r\nIf you enable this policy setting, you can configure ISATAP with one of the following settings:\r\n\r\nPolicy Default State: If the ISATAP router name is resolved successfully, the host will have ISATAP configured with a link-local address and an address for each prefix received from the ISATAP router through stateless address auto-configuration. If the ISATAP router name is not resolved successfully, ISATAP connectivity is not available on the host using the corresponding IPv4 address.\r\n\r\nPolicy Enabled State: If the ISATAP name is resolved successfully, the host will have ISATAP configured with a link-local address and an address for each prefix received from the ISATAP router through stateless address auto-configuration. If the ISATAP name is not resolved successfully, the host will have an ISATAP interface configured with a link-local address.\r\n\r\nPolicy Disabled State: No ISATAP interfaces are present on the host.\r\n\r\n\r\n ","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/ISATAP_State","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_isatap_state","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-tcpip#admx-tcpip-isatap-state"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_isatap_state_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_isatap_state_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_isatap_state_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_tcpip_isatap_state_stateselect","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_teredo_client_port","name":"Teredo_Client_Port","displayName":"Set Teredo Client Port","description":"This policy setting allows you to select the UDP port the Teredo client will use to send packets. If you leave the default of 0, the operating system will select a port (recommended). If you select a UDP port that is already in use by a system, the Teredo client will fail to initialize.\r\n\r\nIf you enable this policy setting, you can customize a UDP port for the Teredo client.\r\n\r\nIf you disable or do not configure this policy setting, the local host setting is used.\r\n\r\n\r\n ","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/Teredo_Client_Port","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_client_port","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-tcpip#admx-tcpip-teredo-client-port"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_client_port_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_teredo_client_port_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_teredo_client_port_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_tcpip_teredo_client_port_teredoclientportbox","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_teredo_refresh_rate","name":"Teredo_Refresh_Rate","displayName":"Set Teredo Refresh Rate","description":"This policy setting allows you to configure the Teredo refresh rate.\r\n\r\nNote: On a periodic basis (by default, every 30 seconds), Teredo clients send a single Router Solicitation packet to the Teredo server. The Teredo server sends a Router Advertisement Packet in response. This periodic packet refreshes the IP address and UDP port mapping in the translation table of the Teredo client's NAT device.\r\n\r\nIf you enable this policy setting, you can specify the refresh rate.  If you choose a refresh rate longer than the port mapping in the Teredo client's NAT device, Teredo might stop working or connectivity might be intermittent.\r\n\r\nIf you disable or do not configure this policy setting, the refresh rate is configured using the local settings on the computer. The default refresh rate is 30 seconds.\r\n\r\n\r\n ","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/Teredo_Refresh_Rate","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_refresh_rate","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-tcpip#admx-tcpip-teredo-refresh-rate"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_refresh_rate_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_teredo_refresh_rate_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_teredo_refresh_rate_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_tcpip_teredo_refresh_rate_teredorefreshratebox","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name_routernamebox","name":"RouterNameBox","displayName":"Enter a router or relay name:","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/6to4_Router_Name","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_isatap_state_stateselect","name":"StateSelect","displayName":"Select from the following states:","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/ISATAP_State","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_isatap_state","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_isatap_state_stateselect_default","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_isatap_state_stateselect_default","displayName":"Default State","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_isatap_state_stateselect_enabled","displayName":"Enabled State","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_isatap_state_stateselect_disabled","displayName":"Disabled State","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_teredo_server_name_teredoservernamebox","name":"TeredoServerNameBox","displayName":"Enter a Teredo server name:","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/Teredo_Server_Name","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_server_name","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_teredo_state_stateselect","name":"StateSelect","displayName":"Select from the following states:","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/Teredo_State","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_state","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_state_stateselect_default","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_teredo_state_stateselect_default","displayName":"Default State","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_teredo_state_stateselect_disabled","displayName":"Disabled State","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_teredo_state_stateselect_client","displayName":"Client","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_teredo_state_stateselect_enterprise client","displayName":"Enterprise Client","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_6to4_state","name":"6to4_State","displayName":"Set 6to4 State","description":"This policy setting allows you to configure 6to4, an address assignment and router-to-router automatic tunneling technology that is used to provide unicast IPv6 connectivity between IPv6 sites and hosts across the IPv4 Internet. 6to4 uses the global address prefix: 2002:WWXX:YYZZ::/48 in which the letters are a hexadecimal representation of the global IPv4 address (w.x.y.z) assigned to a site.\r\n\r\nIf you disable or do not configure this policy setting, the local host setting is used.\r\n\r\nIf you enable this policy setting, you can configure 6to4 with one of the following settings:\r\n\r\nPolicy Default State: 6to4 is enabled if the host has only link-local IPv6 connectivity and a public IPv4 address. If no global IPv6 address is present and no global IPv4 address is present, the host will not have a 6to4 interface. If no global IPv6 address is present and a global IPv4 address is present, the host will have a 6to4 interface.\r\n\r\nPolicy Enabled State: If a global IPv4 address is present, the host will have a 6to4 interface. If no global IPv4 address is present, the host will not have a 6to4 interface.\r\n\r\nPolicy Disabled State: 6to4 is turned off and connectivity with 6to4 will not be available.\r\n\r\n\r\n ","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/6to4_State","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_6to4_state","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-tcpip#admx-tcpip-6to4-state"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_6to4_state_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_6to4_state_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_6to4_state_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_tcpip_6to4_state_stateselect","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_teredo_default_qualified_stateselect","name":"StateSelect","displayName":"Select from the following states:","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/Teredo_Default_Qualified","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_default_qualified","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_default_qualified_stateselect_enabled","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_teredo_default_qualified_stateselect_enabled","displayName":"Enabled State","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name","name":"6to4_Router_Name","displayName":"Set 6to4 Relay Name","description":"This policy setting allows you to specify a 6to4 relay name for a 6to4 host. A 6to4 relay is used as a default gateway for IPv6 network traffic sent by the 6to4 host. The 6to4 relay name setting has no effect if 6to4 connectivity is not available on the host.\r\n\r\nIf you enable this policy setting, you can specify a relay name for a 6to4 host.\r\n\r\nIf you disable or do not configure this policy setting, the local host setting is used, and you cannot specify a relay name for a 6to4 host.\r\n\r\n\r\n ","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/6to4_Router_Name","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-tcpip#admx-tcpip-6to4-router-name"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_tcpip_6to4_router_name_routernamebox","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_6to4_state_stateselect","name":"StateSelect","displayName":"Select from the following states:","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/6to4_State","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_6to4_state","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_6to4_state_stateselect_default","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_6to4_state_stateselect_default","displayName":"Default State","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_6to4_state_stateselect_enabled","displayName":"Enabled State","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_6to4_state_stateselect_disabled","displayName":"Disabled State","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_iphttps_clientstate","name":"IPHTTPS_ClientState","displayName":"Set IP-HTTPS State","description":"This policy setting allows you to configure IP-HTTPS, a tunneling technology that uses the HTTPS protocol to provide IP connectivity to a remote network.\r\n\r\nIf you disable or do not configure this policy setting, the local host settings are used.\r\n\r\nIf you enable this policy setting, you can specify an IP-HTTPS server URL. You will be able to configure IP-HTTPS with one of the following settings:\r\n\r\nPolicy Default State: The IP-HTTPS interface is used when there are no other connectivity options.\r\n\r\nPolicy Enabled State: The IP-HTTPS interface is always present, even if the host has other connectivity options.\r\n\r\nPolicy Disabled State: No IP-HTTPS interfaces are present on the host.\r\n\r\n\r\n ","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/IPHTTPS_ClientState","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_iphttps_clientstate","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-tcpip#admx-tcpip-iphttps-clientstate"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_iphttps_clientstate_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_iphttps_clientstate_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_iphttps_clientstate_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_tcpip_iphttps_clientstate_stateselect","required":true},{"dependedOnBy":"device_vendor_msft_policy_config_admx_tcpip_iphttps_clientstate_iphttpsclienturlbox","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_tcpip_teredo_state","name":"Teredo_State","displayName":"Set Teredo State","description":"This policy setting allows you to configure Teredo, an address assignment and automatic tunneling technology that provides unicast IPv6 connectivity across the IPv4 Internet.\r\n\r\nIf you disable or do not configure this policy setting, the local host settings are used.\r\n\r\nIf you enable this policy setting, you can configure Teredo with one of the following settings:\r\n\r\nDefault: The default state is \"Client.\"\r\n\r\nDisabled: No Teredo interfaces are present on the host.\r\n\r\nClient: The Teredo interface is present only when the host is not on a network that includes a domain controller.\r\n\r\nEnterprise Client: The Teredo interface is always present, even if the host is on a network that includes a domain controller.\r\n\r\n\r\n ","categoryId":"486f25cc-c865-446e-95b2-c5b061883a7a","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_tcpip/Teredo_State","rootDefinitionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_state","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-tcpip#admx-tcpip-teredo-state"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_tcpip_teredo_state_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_tcpip_teredo_state_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_tcpip_teredo_state_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_tcpip_teredo_state_stateselect","required":true}]}]}]