[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_hideavailabletab","name":"HideAvailableTab","displayName":"Hide the Available tab shown in the Visual Studio Installer","description":"This policy determines whether the Available tab in the installer is visible or not. The Available tab contains suggested products that can be installed by the Visual Studio Installer.\r\n\r\nIf set to 1 (enabled), then users will be prevented from seeing the Available Tab, and thus will not have an ability to install new products from the Available Tab using the installer UI. Users will still be able to install products from the command line or directly through the bootstrapper.\r\n\r\nIf set to 0 (disabled) or missing entirely, users will be able to see the Available Tab and freely install new products that are advertised on the installer UI. Note: This is the default behavior.\r\n\r\nThis functionality requires the Visual Studio 2022 version 17.6 installer to be installed on the client machine.\r\n\r\nFor more information, see http://aka.ms/vs/setup/policies.","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov1~Policy~VisualStudio~InstallandUpdateSettings/HideAvailableTab","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_hideavailabletab","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_hideavailabletab_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_hideavailabletab_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_hideavailabletab_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesenabled_administratorupdatesenableddropid","name":"AdministratorUpdatesEnabledDropID","displayName":"Microsoft Update Channel","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov1~Policy~VisualStudio~InstallandUpdateSettings/AdministratorUpdatesEnabled","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesenabled","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesenabled_administratorupdatesenableddropid_1","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesenabled_administratorupdatesenableddropid_1","displayName":"WSUS/SCCM","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesenabled_administratorupdatesenableddropid_2","displayName":"WSUS/SCCM and Microsoft Updates/Intune","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_sharedinstallationpath_sharedinstallationpath_textbox","name":"SharedInstallationPath_TextBox","displayName":"Shared Installation Path (Device)","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov1~Policy~VisualStudio~InstallandUpdateSettings/SharedInstallationPath","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_sharedinstallationpath","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov2.1~policy~visualstudio~installandupdatesettings_allowstandardusercontrol","name":"AllowStandardUserControl","displayName":"Allow standard users to execute installer operations","description":"Allows users without administrator permissions to manage their Visual Studio installations. \r\n        \r\nIf set to 0 (disabled) or missing entirely, the installer will prompt for administrator permissions using UAC.        \r\n\r\nIf set to 1 (enabled for Update and Rollback), users without administrator permissions can update or rollback without UAC. All other operations will ask for administrator permissions through UAC.  \r\n        \r\nIf set to 2 (enabled for all installer operations), users without administrator permissions can fully manage Visual Studio through the Visual Studio Installer without UAC.\r\n        \r\nFor more information, see http://aka.ms/vs/setup/policies.","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov2.1~Policy~VisualStudio~InstallandUpdateSettings/AllowStandardUserControl","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov2.1~policy~visualstudio~installandupdatesettings_allowstandardusercontrol","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov2.1~policy~visualstudio~installandupdatesettings_allowstandardusercontrol_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov2.1~policy~visualstudio~installandupdatesettings_allowstandardusercontrol_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov2.1~policy~visualstudio~installandupdatesettings_allowstandardusercontrol_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_visualstudiov2.1~policy~visualstudio~installandupdatesettings_allowstandardusercontrol_allowstandardusercontroldropid","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_updateconfigurationfile","name":"UpdateConfigurationFile","displayName":"Custom path to the update configuration file","description":"The custom file path to the update configuration file used for configuring administrator updates. For more information, see https://aka.ms/vs/admin/updates/configurationfile.","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov1~Policy~VisualStudio~InstallandUpdateSettings/UpdateConfigurationFile","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_updateconfigurationfile","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_updateconfigurationfile_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_updateconfigurationfile_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_updateconfigurationfile_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_updateconfigurationfile_updateconfigurationfile_textbox","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_sharedinstallationpath","name":"SharedInstallationPath","displayName":"Shared installation path","description":"The directory where some packages shared across versions of instances of Visual Studio are installed. You can change the value anytime, but it will only affect future installs. Any products already installed to the old location must not be moved or they might not function correctly.\r\n\r\nThe Visual Studio Installer enforces a 150 character limit for the path.","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov1~Policy~VisualStudio~InstallandUpdateSettings/SharedInstallationPath","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_sharedinstallationpath","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_sharedinstallationpath_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_sharedinstallationpath_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_sharedinstallationpath_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_sharedinstallationpath_sharedinstallationpath_textbox","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov6~policy~visualstudio~installandupdatesettings_availabletabproducts_availabletabproducts_textbox","name":"AvailableTabProducts_TextBox","displayName":"Product Ids to display in Available Tab of Visual Studio Installer (Device)","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov6~Policy~VisualStudio~InstallandUpdateSettings/AvailableTabProducts","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov6~policy~visualstudio~installandupdatesettings_availabletabproducts","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_cachepath","name":"CachePath","displayName":"Package manifest and payload cache path","description":"The directory where package manifests and, optionally, payloads are stored.\r\n\r\nThe Visual Studio Installer enforces a 50 character limit for the path.\r\n\r\nFor more information, see http://aka.ms/vs/setup/policies.","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov1~Policy~VisualStudio~InstallandUpdateSettings/CachePath","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_cachepath","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_cachepath_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_cachepath_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_cachepath_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_cachepath_cachepath_textbox","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov2.1~policy~visualstudio~installandupdatesettings_allowstandardusercontrol_allowstandardusercontroldropid","name":"AllowStandardUserControlDropID","displayName":"Define which installer commands Standard Users can execute","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov2.1~Policy~VisualStudio~InstallandUpdateSettings/AllowStandardUserControl","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov2.1~policy~visualstudio~installandupdatesettings_allowstandardusercontrol","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov2.1~policy~visualstudio~installandupdatesettings_allowstandardusercontrol_allowstandardusercontroldropid_1","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov2.1~policy~visualstudio~installandupdatesettings_allowstandardusercontrol_allowstandardusercontroldropid_1","displayName":"Enabled for Update and Rollback","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov2.1~policy~visualstudio~installandupdatesettings_allowstandardusercontrol_allowstandardusercontroldropid_2","displayName":"Enabled for all installer operations","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov6~policy~visualstudio~installandupdatesettings_availabletabproducts","name":"AvailableTabProducts","displayName":"Control what products are available to install on the Visual Studio Installer's Available tab.","description":"This policy can be used to restrict which Visual Studio product shows up on the Installer's Available Tab. For example, including Microsoft.VisualStudio.Product.Professional in the list will cause the Visual Studio Professional edition to be the only available option to install. This policy is only applied to client machines that have just the Visual Studio Installer installed. For more information, see  https://aka.ms/vs/setup/policies.","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov6~Policy~VisualStudio~InstallandUpdateSettings/AvailableTabProducts","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov6~policy~visualstudio~installandupdatesettings_availabletabproducts","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov6~policy~visualstudio~installandupdatesettings_availabletabproducts_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov6~policy~visualstudio~installandupdatesettings_availabletabproducts_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov6~policy~visualstudio~installandupdatesettings_availabletabproducts_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_visualstudiov6~policy~visualstudio~installandupdatesettings_availabletabproducts_availabletabproducts_textbox","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesenabled","name":"AdministratorUpdatesEnabled","displayName":"Enable administrator updates","description":"Allows administrator updates to be visible to and applied to the client computer. \r\n        \r\nIf set to 1 (enabled for WSUS/SCCM), then administrator updates delivered through WSUS and SCCM will be available to Active Direcotry (AD) joined client machines.  \r\n        \r\nIf set to 2 (enabled for WSUS/SCCM and Microsoft Updates/Intune), then administrator updates delivered through either WSUS/SCCM or Microsoft Updates/Intune will be available to either Active Directory (AD) or Azure Active Directory (Azure AD) joined machines that are enrolled in Windows Update for Business (WUfB). Note that the WUfB AllowMUUpdateServicePolicy must be turned on too.\r\n\r\nIf set to 0 (disabled) or missing entirely, then administrator updates will not be available to the machine.        \r\n        \r\nFor more information, see http://aka.ms/vs/setup/policies.","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov1~Policy~VisualStudio~InstallandUpdateSettings/AdministratorUpdatesEnabled","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesenabled","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesenabled_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesenabled_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesenabled_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesenabled_administratorupdatesenableddropid","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_backgrounddownloaddisabled","name":"BackgroundDownloadDisabled","displayName":"Disable downloading updates automatically","description":"Prevent setup from downloading updates automatically for all installed Visual Studio products. You can change the value anytime.","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov1~Policy~VisualStudio~InstallandUpdateSettings/BackgroundDownloadDisabled","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_backgrounddownloaddisabled","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_backgrounddownloaddisabled_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_backgrounddownloaddisabled_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_backgrounddownloaddisabled_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_keepdownloadedpayloads","name":"KeepDownloadedPayloads","displayName":"Keep package payloads after installation","description":"Keep package payloads even after they are installed. You can change the value anytime. Disabling the policy removes any cached package payloads for the instance you repair or modify.\r\n\r\nEnabled by default.\r\n\r\nFor more information, see: http://aka.ms/vs/setup/policies.","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov1~Policy~VisualStudio~InstallandUpdateSettings/KeepDownloadedPayloads","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_keepdownloadedpayloads","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_keepdownloadedpayloads_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_keepdownloadedpayloads_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_keepdownloadedpayloads_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_removeoutofsupport","name":"RemoveOutOfSupport","displayName":"Remove out-of-support components during updates","description":"This setting will cause updates to automatically remove all components from all Visual Studio installations that have transitioned to an out-of-support state.\r\n        \r\nIf set to 1 (enabled), then the Visual Studio installer will remove all out-of-support components during all subsequent updates.  \r\n        \r\nIf set to 0 (disabled) or missing entirely, then the remove out-of-support components behavior will respect other locations where this can be configured, such as commandline parameter or the Update Settings dialog.\r\n        \r\nThis functionality requires the Visual Studio 2022 version 17.4 installer to be installed on the client machine.        \r\n\r\nFor more information, see http://aka.ms/vs/setup/policies.","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov1~Policy~VisualStudio~InstallandUpdateSettings/RemoveOutOfSupport","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_removeoutofsupport","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_removeoutofsupport_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_removeoutofsupport_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_removeoutofsupport_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov5~policy~visualstudio~installandupdatesettings_updatenotificationsoptout","name":"UpdateNotificationsOptOut","displayName":"Disable update notifications in Visual Studio","description":"Allows an administrator to control the update notification in the Visual Studio IDE in specific situations.\r\n\r\nIf set to 0 (blocked) or missing entirely, update notifications will appear in the Visual Studio IDE whenever an update is detected.\r\n\r\nIf set to a 1, the update notification in the Visual Studio IDE will be suppressed for the Enterprise and Professional editions on the Release or LTSC channels, only if they are either receiving updates from a layout or if they are enrolled to receive Visual Studio Administrator Updates.\r\n\r\nFor more information, see https://aka.ms/vs/setup/policies.","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov5~Policy~VisualStudio~InstallandUpdateSettings/UpdateNotificationsOptOut","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov5~policy~visualstudio~installandupdatesettings_updatenotificationsoptout","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov5~policy~visualstudio~installandupdatesettings_updatenotificationsoptout_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov5~policy~visualstudio~installandupdatesettings_updatenotificationsoptout_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov5~policy~visualstudio~installandupdatesettings_updatenotificationsoptout_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_updateconfigurationfile_updateconfigurationfile_textbox","name":"UpdateConfigurationFile_TextBox","displayName":"Custom Path to the Update Config (Device)","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov1~Policy~VisualStudio~InstallandUpdateSettings/UpdateConfigurationFile","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_updateconfigurationfile","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_cachepath_cachepath_textbox","name":"CachePath_TextBox","displayName":"Package Manifest and Payload Cache Path (Device)","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov1~Policy~VisualStudio~InstallandUpdateSettings/CachePath","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_cachepath","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesoptout","name":"AdministratorUpdatesOptOut","displayName":"Opt out of administrator updates","description":"Indicates that the user does not want to receive administrator updates to Visual Studio. \r\n        \r\nIf set to 1 (enabled) then the Visual Studio user does not want to receive administrator updates to Visual Studio. This policy is for the developer user to set if they have admin permissions on the client machine. \r\n        \r\nFor more information, see http://aka.ms/vs/setup/policies.","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov1~Policy~VisualStudio~InstallandUpdateSettings/AdministratorUpdatesOptOut","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesoptout","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesoptout_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesoptout_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_administratorupdatesoptout_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov3~policy~visualstudio~installandupdatesettings_administratorupdatesnotifications","name":"AdministratorUpdatesNotifications","displayName":"Display administrator update notifications","description":"This setting enables Visual Studio to provide administrator update prompts and status information to end users via the Windows toast notification feature.  \r\n \r\nIf set to a 1 (enabled), then Visual Studio will display administrator update notifications.  \r\n\r\nThe Visual Studio administrator update notifications will report administrator update success or failure. In the case of administrator update failure, these notifications will provide information as to what the problem is, which should help facilitate diagnosis and resolution. One common reason that Visual Studio administrator updates fail to apply is because Visual Studio is open and in use. In this situation, the administrator update notifications will also prompt the user to close Visual Studio so that the administrator update can then be applied.  \r\n\r\nThe administrator update notifications are governed by the settings that control Windows toast notifications on the client machine. \r\n\r\nFor more information, see https://aka.ms/vs/admin/updates/control.","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov3~Policy~VisualStudio~InstallandUpdateSettings/AdministratorUpdatesNotifications","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov3~policy~visualstudio~installandupdatesettings_administratorupdatesnotifications","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov3~policy~visualstudio~installandupdatesettings_administratorupdatesnotifications_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov3~policy~visualstudio~installandupdatesettings_administratorupdatesnotifications_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov3~policy~visualstudio~installandupdatesettings_administratorupdatesnotifications_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov8~policy~visualstudio~installandupdatesettings_disablemigrationdialog","name":"DisableMigrationDialog","displayName":"Disable the dialog in the IDE that prompts users to stay on the latest version of Visual Studio.","description":"If this setting is enabled, it will prevent your users from seeing the dialog that prompts users to stay on the latest version in the Visual Studio IDE. For more information, see: https://aka.ms/vs/setup/policies.","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov8~Policy~VisualStudio~InstallandUpdateSettings/DisableMigrationDialog","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov8~policy~visualstudio~installandupdatesettings_disablemigrationdialog","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov8~policy~visualstudio~installandupdatesettings_disablemigrationdialog_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov8~policy~visualstudio~installandupdatesettings_disablemigrationdialog_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov8~policy~visualstudio~installandupdatesettings_disablemigrationdialog_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_disablerollback","name":"DisableRollback","displayName":"Disable the ability to rollback or undo a Visual Studio update","description":"This policy determines whether the user can undo an update and rollback Visual Studio to the previously installed version.\r\n\r\nIf set to 1 (enabled), then users will be prevented from accessing the rollback capability, which will prevent Visual Studio from reverting the most recent update which may contain a security fix.\r\n\r\nIf set to 0 (disabled) or missing entirely, then users will be able to access the rollback feature in Visual Studio, and will be able to undo an update and rollback their Visual Studio instances to the previously installed version. Note: The default unconfigured setting enables the ability to rollback a Visual Studio update.\r\n\r\nThis policy applies to release instances of Visual Studio 2022 or higher that may be installed on the machine.\r\n\r\nFor more information, see http://aka.ms/vs/setup/policies.","categoryId":"175ddbac-b0ae-4d9d-b76e-4eb1a487fc93","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/VisualStudiov1~Policy~VisualStudio~InstallandUpdateSettings/DisableRollback","rootDefinitionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_disablerollback","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_disablerollback_0","options":[{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_disablerollback_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_visualstudiov1~policy~visualstudio~installandupdatesettings_disablerollback_1","displayName":"Enabled","dependedOnBy":[]}]}]