[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_3","name":"Channel_Log_FileLogAccess_3","displayName":"Configure log access","description":"This policy setting specifies the security descriptor to use for the log using the Security Descriptor Definition Language (SDDL) string.\r\n\r\nIf you enable this policy setting, only those users matching the security descriptor can access the log.\r\n\r\nIf you disable or do not configure this policy setting, all authenticated users and system services can write, read, or clear this log.\r\n\r\nNote: If you enable this policy setting, some tools and APIs may ignore it. The same change should be made to the \"Configure log access (legacy)\" policy setting to enforce this change across all tools and APIs.\r\n ","categoryId":"1a2a4fc8-c54b-4906-a422-7dd51a196211","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_EventLog/Channel_Log_FileLogAccess_3","rootDefinitionId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_3","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-eventlog#admx-eventlog-channel-log-filelogaccess-3"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_3_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_3_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_3_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_3_channel_log_filelogaccess","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_eventlog_channel_logenabled","name":"Channel_LogEnabled","displayName":"Turn on logging","description":"This policy setting turns on logging.\r\n\r\nIf you enable or do not configure this policy setting, then events can be written to this log.\r\n\r\nIf the policy setting is disabled, then no new events can be logged. Events can always be read from the log, regardless of this policy setting.\r\n ","categoryId":"1a2a4fc8-c54b-4906-a422-7dd51a196211","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_EventLog/Channel_LogEnabled","rootDefinitionId":"device_vendor_msft_policy_config_admx_eventlog_channel_logenabled","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-eventlog#admx-eventlog-channel-logenabled"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_eventlog_channel_logenabled_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_eventlog_channel_logenabled_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_eventlog_channel_logenabled_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_eventlog_channel_logfilepath_3","name":"Channel_LogFilePath_3","displayName":"Control the location of the log file","description":"This policy setting controls the location of the log file. The location of the file must be writable by the Event Log service and should only be accessible to administrators.\r\n\r\nIf you enable this policy setting, the Event Log uses the path specified in this policy setting.\r\n\r\nIf you disable or do not configure this policy setting, the Event Log uses the folder %SYSTEMROOT%\\System32\\winevt\\Logs.\r\n ","categoryId":"1a2a4fc8-c54b-4906-a422-7dd51a196211","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_EventLog/Channel_LogFilePath_3","rootDefinitionId":"device_vendor_msft_policy_config_admx_eventlog_channel_logfilepath_3","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-eventlog#admx-eventlog-channel-logfilepath-3"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_eventlog_channel_logfilepath_3_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_eventlog_channel_logfilepath_3_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_eventlog_channel_logfilepath_3_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_eventlog_channel_logfilepath_3_channel_logfilepath","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_eventlog_channel_logmaxsize_3_channel_logmaxsize","name":"Channel_LogMaxSize","displayName":"Maximum Log Size (KB)","categoryId":"1a2a4fc8-c54b-4906-a422-7dd51a196211","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_EventLog/Channel_LogMaxSize_3","rootDefinitionId":"device_vendor_msft_policy_config_admx_eventlog_channel_logmaxsize_3","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_eventlog_channel_log_autobackup_3","name":"Channel_Log_AutoBackup_3","displayName":"Back up log automatically when full","description":"This policy setting controls Event Log behavior when the log file reaches its maximum size and takes effect only if the \"Retain old events\" policy setting is enabled.\r\n\r\nIf you enable this policy setting and the \"Retain old events\" policy setting is enabled, the Event Log file is automatically closed and renamed when it is full. A new file is then started.\r\n\r\nIf you disable this policy setting and the \"Retain old events\" policy setting is enabled, new events are discarded and old events are retained.\r\n\r\nIf you do not configure this policy setting and the \"Retain old events\" policy setting is enabled, new events are discarded and the old events are retained.\r\n ","categoryId":"1a2a4fc8-c54b-4906-a422-7dd51a196211","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_EventLog/Channel_Log_AutoBackup_3","rootDefinitionId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_autobackup_3","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-eventlog#admx-eventlog-channel-log-autobackup-3"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_autobackup_3_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_autobackup_3_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_autobackup_3_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_3_channel_log_filelogaccess","name":"Channel_Log_FileLogAccess","displayName":"Log Access","categoryId":"1a2a4fc8-c54b-4906-a422-7dd51a196211","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_EventLog/Channel_Log_FileLogAccess_3","rootDefinitionId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_3","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_eventlog_channel_log_retention_3","name":"Channel_Log_Retention_3","displayName":"Control Event Log behavior when the log file reaches its maximum size","description":"This policy setting controls Event Log behavior when the log file reaches its maximum size.\r\n\r\nIf you enable this policy setting and a log file reaches its maximum size, new events are not written to the log and are lost.\r\n\r\nIf you disable or do not configure this policy setting and a log file reaches its maximum size, new events overwrite old events.\r\n\r\nNote: Old events may or may not be retained according to the \"Backup log automatically when full\" policy setting.\r\n ","categoryId":"1a2a4fc8-c54b-4906-a422-7dd51a196211","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_EventLog/Channel_Log_Retention_3","rootDefinitionId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_retention_3","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-eventlog#admx-eventlog-channel-log-retention-3"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_retention_3_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_retention_3_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_retention_3_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_7","name":"Channel_Log_FileLogAccess_7","displayName":"Configure log access (legacy)","description":"This policy setting specifies the security descriptor to use for the log using the Security Descriptor Definition Language (SDDL) string. You must set both \"configure log access\" policy settings for this log in order to affect the both modern and legacy tools.\r\n\r\nIf you enable this policy setting, only those users matching the security descriptor can access the log.\r\n\r\nIf you disable this policy setting, all authenticated users and system services can write, read, or clear this log.\r\n\r\nIf you do not configure this policy setting, the previous policy setting configuration remains in effect.\r\n ","categoryId":"1a2a4fc8-c54b-4906-a422-7dd51a196211","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_EventLog/Channel_Log_FileLogAccess_7","rootDefinitionId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_7","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-eventlog#admx-eventlog-channel-log-filelogaccess-7"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_7_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_7_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_7_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_7_channel_log_filelogaccess","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_7_channel_log_filelogaccess","name":"Channel_Log_FileLogAccess","displayName":"Log Access","categoryId":"1a2a4fc8-c54b-4906-a422-7dd51a196211","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_EventLog/Channel_Log_FileLogAccess_7","rootDefinitionId":"device_vendor_msft_policy_config_admx_eventlog_channel_log_filelogaccess_7","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_eventlog_channel_logmaxsize_3","name":"Channel_LogMaxSize_3","displayName":"Specify the maximum log file size (KB)","description":"This policy setting specifies the maximum size of the log file in kilobytes.\r\n\r\nIf you enable this policy setting, you can configure the maximum log file size to be between 1 megabyte (1024 kilobytes) and 2 terabytes (2147483647 kilobytes), in kilobyte increments.\r\n\r\nIf you disable or do not configure this policy setting, the maximum size of the log file will be set to the locally configured value. This value can be changed by the local administrator using the Log Properties dialog, and it defaults to 1 megabyte.\r\n ","categoryId":"1a2a4fc8-c54b-4906-a422-7dd51a196211","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_EventLog/Channel_LogMaxSize_3","rootDefinitionId":"device_vendor_msft_policy_config_admx_eventlog_channel_logmaxsize_3","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-eventlog#admx-eventlog-channel-logmaxsize-3"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_eventlog_channel_logmaxsize_3_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_eventlog_channel_logmaxsize_3_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_eventlog_channel_logmaxsize_3_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_eventlog_channel_logmaxsize_3_channel_logmaxsize","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_eventlog_channel_logfilepath_3_channel_logfilepath","name":"Channel_LogFilePath","displayName":"Log File Path","categoryId":"1a2a4fc8-c54b-4906-a422-7dd51a196211","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_EventLog/Channel_LogFilePath_3","rootDefinitionId":"device_vendor_msft_policy_config_admx_eventlog_channel_logfilepath_3","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]}]