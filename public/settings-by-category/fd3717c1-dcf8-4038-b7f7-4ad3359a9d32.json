[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSettingGroupCollectionDefinition","id":"com.apple.xsan.preferences_com.apple.xsan.preferences","name":"com.apple.xsan.preferences","displayName":"Top Level Setting Group Collection","description":"Synthetic Top Level Setting Group Collection","categoryId":"fd3717c1-dcf8-4038-b7f7-4ad3359a9d32","offsetUri":"com.apple.xsan.preferences","rootDefinitionId":"com.apple.xsan.preferences_com.apple.xsan.preferences","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[{"dependedOnBy":"com.apple.xsan.preferences_onlymount","required":false},{"dependedOnBy":"com.apple.xsan.preferences_denymount","required":false},{"dependedOnBy":"com.apple.xsan.preferences_denydlc","required":false},{"dependedOnBy":"com.apple.xsan.preferences_preferdlc","required":false},{"dependedOnBy":"com.apple.xsan.preferences_usedlc","required":false}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingCollectionDefinition","id":"com.apple.xsan.preferences_denymount","name":"denyMount","displayName":"Deny Mount","description":"An array of Xsan or StorNext volume names. If no Only Mount array is present, the Xsan client automatically attempts to mount all SAN volumes except the volumes in this array. The system administrator can mount those volumes manually by using the xsanctl(8) mount command.","categoryId":"fd3717c1-dcf8-4038-b7f7-4ad3359a9d32","offsetUri":"denyMount","rootDefinitionId":"com.apple.xsan.preferences_com.apple.xsan.preferences","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"com.apple.xsan.preferences_usedlc","name":"useDLC","displayName":"Use DLC","description":"If true, use the DLC for all volumes.","categoryId":"fd3717c1-dcf8-4038-b7f7-4ad3359a9d32","offsetUri":"useDLC","rootDefinitionId":"com.apple.xsan.preferences_com.apple.xsan.preferences","uxBehavior":"toggle","applicability":{"platform":"macOS","technologies":"mdm,appleRemoteManagement"},"defaultOptionId":"com.apple.xsan.preferences_usedlc_false","options":[{"itemId":"com.apple.xsan.preferences_usedlc_false","displayName":"False","dependedOnBy":[]},{"itemId":"com.apple.xsan.preferences_usedlc_true","displayName":"True","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingCollectionDefinition","id":"com.apple.xsan.preferences_denydlc","name":"denyDLC","displayName":"Deny DLC","description":"An array of StorNext volume names. If the Xsan client is attempting to mount a volume named in this array, the client only mounts the volume if its logical units (LUNs) are available through Fibre Channel. It doesn't attempt to mount the volume using Distributed LAN Client (DLC).","categoryId":"fd3717c1-dcf8-4038-b7f7-4ad3359a9d32","offsetUri":"denyDLC","rootDefinitionId":"com.apple.xsan.preferences_com.apple.xsan.preferences","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingCollectionDefinition","id":"com.apple.xsan.preferences_onlymount","name":"onlyMount","displayName":"Only Mount","description":"An array of Xsan or StorNext volume names. The Xsan client attempts to automatically mount these volumes at startup. The system administrator can mount additional volumes manually by using the xsanctl(8) mount command.","categoryId":"fd3717c1-dcf8-4038-b7f7-4ad3359a9d32","offsetUri":"onlyMount","rootDefinitionId":"com.apple.xsan.preferences_com.apple.xsan.preferences","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingCollectionDefinition","id":"com.apple.xsan.preferences_preferdlc","name":"preferDLC","displayName":"Prefer DLC","description":"An array of StorNext volume names. If the Xsan client is attempting to mount a volume named in this array, the Xsan client attempts to mount the volume using DLC. If DLC isn't available, the client attempts to mount the volume if its LUNs are available through Fibre Channel. The volume name must not also appear in Deny DLC.","categoryId":"fd3717c1-dcf8-4038-b7f7-4ad3359a9d32","offsetUri":"preferDLC","rootDefinitionId":"com.apple.xsan.preferences_com.apple.xsan.preferences","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]}]