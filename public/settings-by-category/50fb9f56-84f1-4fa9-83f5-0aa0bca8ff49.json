e_vendor_msft_policy_config_admx_filesys_disabledeletenotification","name":"DisableDeleteNotification","displayName":"Disable delete notifications on all volumes","description":"Delete notification is a feature that notifies the underlying storage device of clusters that are freed due to a file delete operation.\r\n\r\nA value of 0, the default, will enable delete notifications for all volumes. \r\nA value of 1 will disable delete notifications for all volumes.\r\n ","categoryId":"50fb9f56-84f1-4fa9-83f5-0aa0bca8ff49","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_FileSys/DisableDeleteNotification","rootDefinitionId":"device_vendor_msft_policy_config_admx_filesys_disabledeletenotification","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-filesys#admx-filesys-disabledeletenotification"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_filesys_disabledeletenotification_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_filesys_disabledeletenotification_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_filesys_disabledeletenotification_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation","name":"SymlinkEvaluation","displayName":"Selectively allow the evaluation of a symbolic link","description":"Symbolic links can introduce vulnerabilities in certain applications. To mitigate this issue, you can selectively enable or disable the evaluation of these types of symbolic links:\r\n\r\nLocal Link to a Local Target\r\nLocal Link to a Remote Target\r\nRemote Link to Remote Target\r\nRemote Link to Local Target\r\n\r\nFor further information please refer to the Windows Help section\r\n\r\nNOTE: If this policy is Disabled or Not Configured, local administrators may select the types of symbolic links to be evaluated.\r\n ","categoryId":"50fb9f56-84f1-4fa9-83f5-0aa0bca8ff49","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_FileSys/SymlinkEvaluation","rootDefinitionId":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-filesys#admx-filesys-symlinkevaluation"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation_symlinkclassl2l","required":true},{"dependedOnBy":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation_symlinkclassl2r","required":true},{"dependedOnBy":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation_symlinkclassr2r","required":true},{"dependedOnBy":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation_symlinkclassr2l","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_filesystem_devdriveattachpolicy","name":"DevDriveAttachPolicy","displayName":"Dev drive filter attach policy","description":"Dev drive is a drive optimized for performance considering developer scenarios and by default no file system filters are attached to it. Filters listed in this setting will be allowed to attach even on a dev drive.\r\n\r\nA reboot is required for this setting to take effect.\r\n ","categoryId":"50fb9f56-84f1-4fa9-83f5-0aa0bca8ff49","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/FileSystem/DevDriveAttachPolicy","rootDefinitionId":"device_vendor_msft_policy_config_filesystem_devdriveattachpolicy","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-filesystem#filesystem-devdriveattachpolicy"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_filesystem_devdriveattachpolicy_0","options":[{"itemId":"device_vendor_msft_policy_config_filesystem_devdriveattachpolicy_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_filesystem_devdriveattachpolicy_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_filesystem_devdriveattachpolicy_devdriveattachpolicy","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_filesystem_enabledevdrive","name":"EnableDevDrive","displayName":"Enable dev drive","description":"Dev drive or developer volume is a volume optimized for performance of developer scenarios. A developer volume allows an administrator to choose file system filters that are attached on the volume.\r\n\r\nDisabling this setting will disallow creation of new developer volumes, existing developer volumes will mount as regular volumes.\r\n\r\nIf this setting is not configured the default policy is to enable developer volumes while allowing antivirus filter to attach on a deveveloper volume.  Further, if not configured, a local administrator can choose to not have antivirus filter attached to a developer volume.\r\n\r\nA reboot is required for this setting to take effect.\r\n ","categoryId":"50fb9f56-84f1-4fa9-83f5-0aa0bca8ff49","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/FileSystem/EnableDevDrive","rootDefinitionId":"device_vendor_msft_policy_config_filesystem_enabledevdrive","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-filesystem#filesystem-enabledevdrive"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_filesystem_enabledevdrive_0","options":[{"itemId":"device_vendor_msft_policy_config_filesystem_enabledevdrive_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_filesystem_enabledevdrive_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_filesystem_enabledevdrive_devdriveallowantivirusfilter","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation_symlinkclassr2l","name":"SymLinkClassR2L","displayName":"Remote Link to Local Target (Device)","categoryId":"50fb9f56-84f1-4fa9-83f5-0aa0bca8ff49","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_FileSys/SymlinkEvaluation","rootDefinitionId":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation_symlinkclassr2l_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation_symlinkclassr2l_0","displayName":"False","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation_symlinkclassr2l_1","displayName":"True","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation_symlinkclassr2r","name":"SymLinkClassR2R","displayName":"Remote Link to Remote Target (Device)","categoryId":"50fb9f56-84f1-4fa9-83f5-0aa0bca8ff49","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_FileSys/SymlinkEvaluation","rootDefinitionId":"device_vendor_msft_policy_config_admx_filesys_symlinkevaluation","uxBeh