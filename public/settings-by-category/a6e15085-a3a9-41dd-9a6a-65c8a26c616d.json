[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_wirelessdisplay_allowmdnsadvertisement","name":"AllowMdnsAdvertisement","displayName":"Allow Mdns Advertisement","description":"This policy setting allows you to turn off the Wireless Display multicast DNS service advertisement from a Wireless Display receiver.","categoryId":"a6e15085-a3a9-41dd-9a6a-65c8a26c616d","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/WirelessDisplay/AllowMdnsAdvertisement","rootDefinitionId":"device_vendor_msft_policy_config_wirelessdisplay_allowmdnsadvertisement","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-WirelessDisplay#allowmdnsadvertisement"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_wirelessdisplay_allowmdnsadvertisement_1","options":[{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_allowmdnsadvertisement_0","displayName":"Not allowed.","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_allowmdnsadvertisement_1","displayName":"Allowed.","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectionfrompc","name":"AllowProjectionFromPC","displayName":"Allow Projection From PC","description":"This policy allows you to turn off projection from a PC.                             If you set it to 0, your PC cannot discover or project to other devices.                             If you set it to 1, your PC can discover and project to other devices.","categoryId":"a6e15085-a3a9-41dd-9a6a-65c8a26c616d","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/WirelessDisplay/AllowProjectionFromPC","rootDefinitionId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectionfrompc","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-WirelessDisplay#allowprojectionfrompc"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectionfrompc_1","options":[{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectionfrompc_0","displayName":"Your PC cannot discover or project to other devices.","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectionfrompc_1","displayName":"Your PC can discover and project to other devices.","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectiontopcoverinfrastructure","name":"AllowProjectionToPCOverInfrastructure","displayName":"Allow Projection To PC Over Infrastructure","description":"This policy setting allows you to turn off projection to a PC over infrastructure.                             If you set it to 0, your PC cannot be discoverable and can't be projected to over infrastructure, though it may still be possible to project over WiFi Direct.                             If you set it to 1, your PC can be discoverable and can be projected to over infrastructure.","categoryId":"a6e15085-a3a9-41dd-9a6a-65c8a26c616d","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/WirelessDisplay/AllowProjectionToPCOverInfrastructure","rootDefinitionId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectiontopcoverinfrastructure","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-WirelessDisplay#allowprojectiontopcoverinfrastructure"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectiontopcoverinfrastructure_1","options":[{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectiontopcoverinfrastructure_0","displayName":"Your PC is not discoverable and other devices cannot project to it over infrastructure, although it is possible to project to it over WiFi Direct.","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectiontopcoverinfrastructure_1","displayName":"Your PC is discoverable and other devices can project to it over infrastructure.","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectionfrompcoverinfrastructure","name":"AllowProjectionFromPCOverInfrastructure","displayName":"Allow Projection From PC Over Infrastructure","description":"This policy allows you to turn off projection from a PC over infrastructure.                             If you set it to 0, your PC cannot discover or project to other infrastructure devices, though it may still be possible to discover and project over WiFi Direct.                             If you set it to 1, your PC can discover and project to other devices over infrastructure.","categoryId":"a6e15085-a3a9-41dd-9a6a-65c8a26c616d","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/WirelessDisplay/AllowProjectionFromPCOverInfrastructure","rootDefinitionId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectionfrompcoverinfrastructure","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-WirelessDisplay#allowprojectionfrompcoverinfrastructure"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectionfrompcoverinfrastructure_1","options":[{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectionfrompcoverinfrastructure_0","displayName":"Your PC cannot discover or project to other infrastructure devices, although it is possible to discover and project over WiFi Direct.","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectionfrompcoverinfrastructure_1","displayName":"Your PC can discover and project to other devices over infrastructure.","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_wirelessdisplay_allowuserinputfromwirelessdisplayreceiver","name":"AllowUserInputFromWirelessDisplayReceiver","displayName":"Allow User Input From Wireless Display Receiver","description":"Setting this policy controls whether or not the wireless display can send input—keyboard, mouse, pen, and touch input if the display supports it—back to the source device.","categoryId":"a6e15085-a3a9-41dd-9a6a-65c8a26c616d","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/WirelessDisplay/AllowUserInputFromWirelessDisplayReceiver","rootDefinitionId":"device_vendor_msft_policy_config_wirelessdisplay_allowuserinputfromwirelessdisplayreceiver","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-WirelessDisplay#allowuserinputfromwirelessdisplayreceiver"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_wirelessdisplay_allowuserinputfromwirelessdisplayreceiver_1","options":[{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_allowuserinputfromwirelessdisplayreceiver_0","displayName":"Wireless display input disabled.","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_allowuserinputfromwirelessdisplayreceiver_1","displayName":"Wireless display input enabled.","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_wirelessdisplay_requirepinforpairing","name":"RequirePinForPairing","displayName":"Require Pin For Pairing","description":"This policy setting allows you to require a pin for pairing.                             If you set this to 0, a pin isn't required for pairing.                             If you set this to 1, the pairing ceremony for new devices will always require a PIN.                             If you set this to 2, all pairings will require PIN.","categoryId":"a6e15085-a3a9-41dd-9a6a-65c8a26c616d","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/WirelessDisplay/RequirePinForPairing","rootDefinitionId":"device_vendor_msft_policy_config_wirelessdisplay_requirepinforpairing","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-WirelessDisplay#requirepinforpairing"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_wirelessdisplay_requirepinforpairing_0","options":[{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_requirepinforpairing_0","displayName":"PIN is not required.","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_requirepinforpairing_1","displayName":"Pairing ceremony for new devices will always require a PIN","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_requirepinforpairing_2","displayName":"All pairings will require PIN","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectiontopc","name":"AllowProjectionToPC","displayName":"Allow Projection To PC","description":"This policy setting allows you to turn off projection to a PC                             If you set it to 0, your PC can't be discoverable or projected to over Wi-Fi Direct.                              If you set it to 1, your PC can be discoverable and projected to over Wi-Fi Direct. The user has an option to turn it always on or off except for manual launch, too.","categoryId":"a6e15085-a3a9-41dd-9a6a-65c8a26c616d","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/WirelessDisplay/AllowProjectionToPC","rootDefinitionId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectiontopc","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-WirelessDisplay#allowprojectiontopc"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectiontopc_1","options":[{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectiontopc_0","displayName":"Projection to PC is not allowed. Always off and the user cannot enable it.","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_allowprojectiontopc_1","displayName":"Projection to PC is allowed. Enabled only above the lock screen.","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_wirelessdisplay_allowmdnsdiscovery","name":"AllowMdnsDiscovery","displayName":"Allow Mdns Discovery","description":"This policy setting allows you to turn off discovering the display service advertised over multicast DNS by a Wireless Display receiver.","categoryId":"a6e15085-a3a9-41dd-9a6a-65c8a26c616d","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/WirelessDisplay/AllowMdnsDiscovery","rootDefinitionId":"device_vendor_msft_policy_config_wirelessdisplay_allowmdnsdiscovery","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-WirelessDisplay#allowmdnsdiscovery"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_wirelessdisplay_allowmdnsdiscovery_1","options":[{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_allowmdnsdiscovery_0","displayName":"Not allowed.","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_wirelessdisplay_allowmdnsdiscovery_1","disp