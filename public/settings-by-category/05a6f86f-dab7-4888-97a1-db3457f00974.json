ls whether users can modify the admin-managed Writing Assistance blocklist.\nIf you enable this policy setting (or do not configure it), the admin blocklist is locked and users cannot remove entries from it.\nIf you disable this policy setting, users can remove individual entries from the admin-provided blocklist.\n      ","categoryId":"05a6f86f-dab7-4888-97a1-db3457f00974","baseUri":"./User/Vendor/MSFT/Policy","offsetUri":"/Config/office16~Policy~L_MicrosoftOfficeSystem~L_WritingAssistance/L_WritingAssistantAdminBlocklistLocked","rootDefinitionId":"user_vendor_msft_policy_config_office16~policy~l_microsoftofficesystem~l_writingassistance_l_writingassistantadminblocklistlocked","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"user_vendor_msft_policy_config_office16~policy~l_microsoftofficesystem~l_writingassistance_l_writingassistantadminblocklistlocked_0","options":[{"itemId":"user_vendor_msft_policy_config_office16~policy~l_microsoftofficesystem~l_writingassistance_l_writingassistantadminblocklistlocked_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"user_vendor_msft_policy_config_office16~policy~l_microsoftofficesystem~l_writingassistance_l_writingassistantadminblocklistlocked_1","displayName":"Enabled","dependedOnBy":[]}]}]