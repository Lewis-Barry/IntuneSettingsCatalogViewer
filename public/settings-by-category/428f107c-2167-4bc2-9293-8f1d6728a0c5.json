efenderantivirus_scan_localsettingoverridescheduletime_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_localsettingoverridescheduletime_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_localsettingoverridescheduletime_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disableheuristics","name":"Scan_DisableHeuristics","displayName":"Turn on heuristics","description":"This policy setting allows you to configure heuristics. Suspicious detections will be suppressed right before reporting to the engine client. Turning off heuristics will reduce the capability to flag new threats. It is recommended that you do not turn off heuristics.\r\n\r\n    If you enable or do not configure this setting, heuristics will be enabled.\r\n\r\n    If you disable this setting, heuristics will be disabled.\r\n ","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Scan_DisableHeuristics","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disableheuristics","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-microsoftdefenderantivirus#admx-microsoftdefenderantivirus-scan-disableheuristics"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disableheuristics_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disableheuristics_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disableheuristics_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disableemailscanning","name":"Scan_DisableEmailScanning","displayName":"Turn on e-mail scanning","description":"This policy setting allows you to configure e-mail scanning. When e-mail scanning is enabled, the engine will parse the mailbox and mail files, according to their specific format, in order to analyze the mail bodies and attachments. Several e-mail formats are currently supported, for example: pst (Outlook), dbx, mbx, mime (Outlook Express), binhex (Mac).\r\n\r\n    If you enable this setting, e-mail scanning will be enabled.\r\n\r\n    If you disable or do not configure this setting, e-mail scanning will be disabled.\r\n ","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Scan_DisableEmailScanning","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disableemailscanning","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-microsoftdefenderantivirus#admx-microsoftdefenderantivirus-scan-disableemailscanning"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disableemailscanning_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disableemailscanning_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disableemailscanning_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday","name":"Scan_ScheduleDay","displayName":"Specify the day of the week to run a scheduled scan","description":"This policy setting allows you to specify the day of the week on which to perform a scheduled scan. The scan can also be configured to run every day or to never run at all.\r\n\r\n    This setting can be configured with the following ordinal number values:\r\n    (0x0) Every Day\r\n    (0x1) Sunday \r\n    (0x2) Monday\r\n    (0x3) Tuesday\r\n    (0x4) Wednesday\r\n    (0x5) Thursday\r\n    (0x6) Friday\r\n    (0x7) Saturday\r\n    (0x8) Never (default)\r\n\r\n    If you enable this setting, a scheduled scan will run at the frequency specified.\r\n\r\n    If you disable or do not configure this setting, a scheduled scan will run at a default frequency.\r\n ","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Scan_ScheduleDay","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-microsoftdefenderantivirus#admx-microsoftdefenderantivirus-scan-scheduleday"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday_scan_scheduleday","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_missedscheduledscancountbeforecatchup","name":"Scan_MissedScheduledScanCountBeforeCatchup","displayName":"Define the number of days after which a catch-up scan is forced","description":"\r\n    This policy setting allows you to define the number of consecutive scheduled scans that can be missed after which a catch-up scan will be forced. By default, the value of this setting is 2 consecutive scheduled scans.\r\n\r\n    If you enable this setting, a catch-up scan will occur after the specified number consecutive missed scheduled scans.\r\n\r\n    If you disable or do not configure this setting, a catch-up scan will occur after the 2 consecutive missed scheduled scans.\r\n ","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Scan_MissedScheduledScanCountBeforeCatchup","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_missedscheduledscancountbeforecatchup","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-microsoftdefenderantivirus#admx-microsoftdefenderantivirus-scan-missedscheduledscancountbeforecatchup"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_missedscheduledscancountbeforecatchup_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_missedscheduledscancountbeforecatchup_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_missedscheduledscancountbeforecatchup_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_missedscheduledscancountbeforecatchup_scan_missedscheduledscancountbeforecatchup","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_purgeitemsafterdelay_scan_purgeitemsafterdelay","name":"Scan_PurgeItemsAfterDelay","displayName":"Turn on removal of items from scan history folder","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Scan_PurgeItemsAfterDelay","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_purgeitemsafterdelay","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]}]