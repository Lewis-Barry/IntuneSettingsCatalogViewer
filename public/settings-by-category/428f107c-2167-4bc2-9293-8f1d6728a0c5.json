le this setting, mapped network drives will be scanned.\r\n\r\n    If you disable or do not configure this setting, mapped network drives will not be scanned.\r\n ","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Scan_DisableScanningMappedNetworkDrivesForFullScan","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disablescanningmappednetworkdrivesforfullscan","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-microsoftdefenderantivirus#admx-microsoftdefenderantivirus-scan-disablescanningmappednetworkdrivesforfullscan"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disablescanningmappednetworkdrivesforfullscan_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disablescanningmappednetworkdrivesforfullscan_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disablescanningmappednetworkdrivesforfullscan_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_archivemaxsize","name":"Scan_ArchiveMaxSize","displayName":"Specify the maximum size of archive files to be scanned","description":"This policy setting allows you to configure the maximum size of archive files such as .ZIP or .CAB that will be scanned. The value represents file size in kilobytes (KB). The default value is 0 and represents no limit to archive size for scanning.\r\n\r\n    If you enable this setting, archive files less than or equal to the size specified will be scanned.\r\n\r\n    If you disable or do not configure this setting, archive files will be scanned according to the default value.\r\n ","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Scan_ArchiveMaxSize","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_archivemaxsize","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-microsoftdefenderantivirus#admx-microsoftdefenderantivirus-scan-archivemaxsize"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_archivemaxsize_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_archivemaxsize_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_archivemaxsize_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_archivemaxsize_scan_archivemaxsize","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_archivemaxdepth","name":"Scan_ArchiveMaxDepth","displayName":"Specify the maximum depth to scan archive files","description":"This policy setting allows you to configure the maximum directory depth level into which archive files such as .ZIP or .CAB are unpacked during scanning. The default directory depth level is 0.\r\n\r\n    If you enable this setting, archive files will be scanned to the directory depth level specified.\r\n\r\n    If you disable or do not configure this setting, archive files will be scanned to the default directory depth level.\r\n ","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Scan_ArchiveMaxDepth","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_archivemaxdepth","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-microsoftdefenderantivirus#admx-microsoftdefenderantivirus-scan-archivemaxdepth"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_archivemaxdepth_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_archivemaxdepth_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_archivemaxdepth_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_archivemaxdepth_scan_archivemaxdepth","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_lowcpupriority","name":"Scan_LowCpuPriority","displayName":"Configure low CPU priority for scheduled scans","description":"\r\n        This policy setting allows you to enable or disable low CPU priority for scheduled scans.\r\n\r\n        If you enable this setting, low CPU priority will be used during scheduled scans.\r\n\r\n        If you disable or do not configure this setting, not changes will be made to CPU priority for scheduled scans.\r\n    \r\n ","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Scan_LowCpuPriority","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_lowcpupriority","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-microsoftdefenderantivirus#admx-microsoftdefenderantivirus-scan-lowcpupriority"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_lowcpupriority_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_lowcpupriority_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_lowcpupriority_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_quickscaninterval","name":"Scan_QuickScanInterval","displayName":"Specify the interval to run quick scans per day","description":"This policy setting allows you to specify an interval at which to perform a quick scan. The time value is represented as the number of hours between quick scans. Valid values range from 1 (every hour) to 24 (once per day). If set to zero, interval quick scans will not occur. By default, this setting is set to 0.\r\n\r\n    If you enable this setting, a quick scan will run at the interval specified.\r\n\r\n    If you disable or do not configure this setting, a quick scan will run at a default time.\r\n ","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Scan_QuickScanInterval","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_quickscaninterval","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-microsoftdefenderantivirus#admx-microsoftdefenderantivirus-scan-quickscaninterval"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_quickscaninterval_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_quickscaninterval_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_quickscaninterval_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_quickscaninterval_scan_quickscaninterval","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scanonlyifidle","name":"Scan_ScanOnlyIfIdle","displayName":"Start the scheduled scan only when computer is on but not in use","description":"This policy setting allows you to configure scheduled scans to start only when your computer is on but not in use.\r\n\r\n    If you enable or do not configure this setting, scheduled scans will only run when the computer is on but not in use.\r\n\r\n    If you disable this setting, scheduled scans will run at the scheduled time.\r\n ","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Scan_ScanOnlyIfIdle","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scanonlyifidle","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-microsoftdefenderantivirus#admx-microsoftdefenderantivirus-scan-scanonlyifidle"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scanonlyifidle_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scanonlyifidle_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scanonlyifidle_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disablerestorepoint","name":"Scan_DisableRestorePoint","displayName":"Create a system restore point","description":"This policy setting allows you to create a system restore point on the computer on a daily basis prior to cleaning. \r\n\r\n    If you enable this setting, a system restore point will be created.\r\n\r\n    If you disable or do not configure this setting, a system restore point will not be created.\r\n ","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Scan_DisableRestorePoint","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disablerestorepoint","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-microsoftdefenderantivirus#admx-microsoftdefenderantivirus-scan-disablerestorepoint"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disablerestorepoint_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disablerestorepoint_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disablerestorepoint_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_purgeitemsafterdelay","name":"Scan_PurgeItemsAfterDelay","displayName":"Turn on removal of items from scan history folder","description":"This policy setting defines the number of days items should be kept in the scan history folder before being permanently removed. The value represents the number of days to keep items in the folder. If set to zero, items will be kept forever and will not be automatically removed. By default, the value is set to 30 days.\r\n\r\n    If you enable this setting, items will be removed from the scan history folder after the number of days specified.\r\n\r\n    If you disable or do not configure this setting, items will be kept in the scan history folder for the default number of days.\r\n ","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Scan_PurgeItemsAfterDelay","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_purgeitemsafterdelay","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-microsoftdefenderantivirus#admx-microsoftdefenderantivirus-scan-purgeitemsafterdelay"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_purgeitemsafterdelay_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_purgeitemsafterdelay_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_purgeitemsafterdelay_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_purgeitemsafterdelay_scan_purgeitemsafterdelay","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday_scan_scheduleday","name":"Scan_ScheduleDay","displayName":"Specify the day of the week to run a scheduled scan","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Scan_ScheduleDay","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday_scan_scheduleday_8","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday_scan_scheduleday_8","displayName":"Never","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday_scan_scheduleday_0","displayName":"Every Day","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday_scan_scheduleday_1","displayName":"Sunday","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday_scan_scheduleday_2","displayName":"Monday","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday_scan_scheduleday_3","displayName":"Tuesday","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday_scan_scheduleday_4","displayName":"Wednesday","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday_scan_scheduleday_5","displayName":"Thursday","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday_scan_scheduleday_6","displayName":"Friday","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_scheduleday_scan_scheduleday_7","displayName":"Saturday","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disableremovabledrivescanning","name":"Scan_DisableRemovableDriveScanning","displayName":"Scan removable drives","description":"This policy setting allows you to manage whether or not to scan for malicious software and unwanted software in the contents of removable drives, such as USB flash drives, when running a full scan.\r\n\r\n    If you enable this setting, removable drives will be scanned during any type of scan.\r\n\r\n    If you disable or do not configure this setting, removable drives will not be scanned during a full scan. Removable drives may still be scanned during quick scan and custom scan.\r\n ","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Scan_DisableRemovableDriveScanning","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disableremovabledrivescanning","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-microsoftdefenderantivirus#admx-microsoftdefenderantivirus-scan-disableremovabledrivescanning"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disableremovabledrivescanning_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disableremovabledrivescanning_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_disableremovabledrivescanning_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_scan_missedscheduledscancountbeforecatchup_scan_missedscheduledscancountbeforecatchup","name":"Scan_MissedScheduledScanCountBeforeCatchup","displayName":"Define the number of scheduled scans that can be missed after which a catch-up scan is forced","categoryId":"428f107c-2167-4bc2-9293-8f1d6728a0c5","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_Mic