[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_filesys_disablecompression","name":"DisableCompression","displayName":"Do not allow compression on all NTFS volumes","description":"Compression can add to the processing overhead of filesystem operations.  Enabling this setting will prevent access to and creation of compressed files. \r\n ","categoryId":"bb54b081-5004-4f05-a46c-f5b948f57b82","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_FileSys/DisableCompression","rootDefinitionId":"device_vendor_msft_policy_config_admx_filesys_disablecompression","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-filesys#admx-filesys-disablecompression"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_filesys_disablecompression_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_filesys_disablecompression_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_filesys_disablecompression_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_filesys_shortnamecreationsettings","name":"ShortNameCreationSettings","displayName":"Short name creation options","description":"These settings provide control over whether or not short names are generated during file creation.  Some applications require short names for compatibility, but short names have a negative performance impact on the system.\r\n\r\nIf you enable short names on all volumes then short names will always be generated.  If you disable them on all volumes then they will never be generated.  If you set short name creation to be configurable on a per volume basis then an on-disk flag will determine whether or not short names are created on a given volume.  If you disable short name creation on all data volumes then short names will only be generated for files created on the system volume.\r\n ","categoryId":"bb54b081-5004-4f05-a46c-f5b948f57b82","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_FileSys/ShortNameCreationSettings","rootDefinitionId":"device_vendor_msft_policy_config_admx_filesys_shortnamecreationsettings","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-filesys#admx-filesys-shortnamecreationsettings"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_filesys_shortnamecreationsettings_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_filesys_shortnamecreationsettings_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_filesys_shortnamecreationsettings_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_filesys_shortnamecreationsettings_shortnamecreationsetting_levels","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_filesys_txfdeprecatedfunctionality","name":"TxfDeprecatedFunctionality","displayName":"Enable / disable TXF deprecated features","description":"TXF deprecated features included savepoints, secondary RM, miniversion and roll forward. Please enable it if you want to use the APIs.\r\n ","categoryId":"bb54b081-5004-4f05-a46c-f5b948f57b82","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_FileSys/TxfDeprecatedFunctionality","rootDefinitionId":"device_vendor_msft_policy_config_admx_filesys_txfdeprecatedfunctionality","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-filesys#admx-filesys-txfdeprecatedfunctionality"],"applicability":{"platform":"windows10","t