[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_clouddesktop_boottocloudmode","name":"BootToCloudMode","displayName":"Boot To Cloud Mode","description":"This policy is used by IT admin to set the configuration mode of cloud PC.\r\n ","categoryId":"39e4c352-be9c-4e75-8111-8236279c7f1e","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/CloudDesktop/BootToCloudMode","rootDefinitionId":"device_vendor_msft_policy_config_clouddesktop_boottocloudmode","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-CloudDesktop#boottocloudmode"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_clouddesktop_boottocloudmode_0","options":[{"itemId":"device_vendor_msft_policy_config_clouddesktop_boottocloudmode_0","displayName":"Not Configured","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_boottocloudmode_1","displayName":"Enable Boot to Cloud Desktop","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"user_vendor_msft_clouddesktop_enablephysicaldeviceaccessonerrorscreens","name":"EnablePhysicalDeviceAccessOnErrorScreens","displayName":"Enable Physical Device Access On Error Screens (User) (Windows Insiders only)","description":"Configuring this node gives access to the physical devices used to boot to Cloud PCs from the error screens for specified users. This node supports these options: 0. Not enabled 1. Enabled.\r\n This setting is only available to Windows Insiders","categoryId":"39e4c352-be9c-4e75-8111-8236279c7f1e","baseUri":"./User/Vendor/MSFT/CloudDesktop","offsetUri":"/EnablePhysicalDeviceAccessOnErrorScreens","rootDefinitionId":"user_vendor_msft_clouddesktop_enablephysicaldeviceaccessonerrorscreens","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/CloudDesktop-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"user_vendor_msft_clouddesktop_enablephysicaldeviceaccessonerrorscreens_false","options":[{"itemId":"user_vendor_msft_clouddesktop_enablephysicaldeviceaccessonerrorscreens_false","displayName":"Access to physical device on error screens disabled","dependedOnBy":[]},{"itemId":"user_vendor_msft_clouddesktop_enablephysicaldeviceaccessonerrorscreens_true","displayName":"Access to physical device on error screens enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"user_vendor_msft_clouddesktop_enablephysicaldeviceaccessonctrlaltdel","name":"EnablePhysicalDeviceAccessOnCtrlAltDel","displayName":"Enable Physical Device Access On Ctrl Alt Del (User) (Windows Insiders only)","description":"Configuring this node gives access to the physical devices used to boot to Cloud PCs from the Ctrl+Alt+Del page for specified users. This node supports these options: 0. Not enabled 1. Enabled.\r\n This setting is only available to Windows Insiders","categoryId":"39e4c352-be9c-4e75-8111-8236279c7f1e","baseUri":"./User/Vendor/MSFT/CloudDesktop","offsetUri":"/EnablePhysicalDeviceAccessOnCtrlAltDel","rootDefinitionId":"user_vendor_msft_clouddesktop_enablephysicaldeviceaccessonctrlaltdel","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/CloudDesktop-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"user_vendor_msft_clouddesktop_enablephysicaldeviceaccessonctrlaltdel_false","options":[{"itemId":"user_vendor_msft_clouddesktop_enablephysicaldeviceaccessonctrlaltdel_false","displayName":"Access to physical device on CtrlAltDel page disabled","dependedOnBy":[]},{"itemId":"user_vendor_msft_clouddesktop_enablephysicaldeviceaccessonctrlaltdel_true","displayName":"Access to physical device on CtrlAltDel page enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout","name":"SetMaxConnectionTimeout","displayName":"Set Max Connection Timeout","description":"IT admins can use this policy to set the max connection timeout. The connection timeout decides the max wait time for connecting to Cloud PC after sign in. The default max value is 5 min. For best user experience, it is recommended to continue with the default timeout of 5 min. Update only if it takes more than 5 min to connect to the Cloud PC in your organization.\r\n ","categoryId":"39e4c352-be9c-4e75-8111-8236279c7f1e","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/CloudDesktop/SetMaxConnectionTimeout","rootDefinitionId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-CloudDesktop#setmaxconnectiontimeout"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_5","options":[{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_5","displayName":"5 min","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_6","displayName":"6 min","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_7","displayName":"7 min","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_8","displayName":"8 min","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_9","displayName":"9 min","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_10","displayName":"10 min","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_11","displayName":"11 min","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_12","displayName":"12 min","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_13","displayName":"13 min","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_14","displayName":"14 min","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_15","displayName":"15 min","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_16","displayName":"16 min","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_17","displayName":"17 min","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_18","displayName":"18 min","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_19","displayName":"19 min","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_clouddesktop_setmaxconnectiontimeout_20","displayName":"20 min","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_clouddesktop_enableboottocloudsharedpcmode","name":"EnableBootToCloudSharedPCMode","displayName":"[Deprecated] Enable Boot To Cloud Shared PC Mode","description":"Setting this node to \"true\" configures boot to cloud for Shared PC mode. Boot to cloud mode enables users to seamlessly sign-in to a Cloud PC. Shared PC mode allows multiple users to sign-in on the device and use for shared purpose. For enabling boot to cloud shared pc feature, Cloud Provider application must be installed on the PC and the user must have a Cloud PC provisioned.\r\n ","categoryId":"39e4c352-be9c-4e75-8111-8236279c7f1e","baseUri":"./Device/Vendor/MSFT/CloudDesktop","offsetUri":"/EnableBootToCloudSharedPCMode","rootDefinitionId":"device_vendor_msft_clouddesktop_enableboottocloudsharedpcmode","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/CloudDesktop-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_clouddesktop_enableboottocloudsharedpcmode_false","options":[{"itemId":"device_vendor_msft_clouddesktop_enableboottocloudsharedpcmode_false","displayName":"Not configured","dependedOnBy":[]},{"itemId":"device_vendor_msft_clouddesktop_enableboottocloudsharedpcmode_true","displayName":"Boot to cloud shared pc mode enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_clouddesktop_boottocloudpcenhanced","name":"BootToCloudPCEnhanced","displayName":"Boot To Cloud PC Enhanced","description":"This node allows to configure different kinds of Boot to Cloud mode. Boot to cloud mode enables users to seamlessly sign-in to a Cloud PC. For using this feature, Cloud Provider application must be installed on the PC and the user must have a Cloud PC provisioned. This node supports the below options: 0. Not Configured. 1. Enable Boot to Cloud Shared PC Mode: Boot to Cloud Shared PC mode allows multiple users to sign-in on the device and use for shared purpose. 2. Enable Boot to Cloud Dedicated Mode (Cloud only): Dedicated mode allows user to sign-in on the device using various authentication mechanism configured by their organization (For ex. PIN, Biometrics etc). This mode preserves user personalization, including their profile picture and username in local machine, and facilitates fast account switching.","categoryId":"39e4c352-be9c-4e75-8111-8236279c7f1e","baseUri":"./Device/Vendor/MSFT/CloudDesktop","offsetUri":"/BootToCloudPCEnhanced","rootDefinitionId":"device_vendor_msft_clouddesktop_boottocloudpcenhanced","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/CloudDesktop-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_clouddesktop_boottocloudpcenhanced_0","options":[{"itemId":"device_vendor_msft_clouddesktop_boottocloudpcenhanced_0","displayName":"Not Configured","dependedOnBy":[]},{"itemId":"device_vendor_msft_clouddesktop_boottocloudpcenhanced_1","displayName":"Enable Boot to Cloud Shared PC Mode","dependedOnBy":[]},{"itemId":"device_vendor_msft_clouddesktop_boottocloudpcenhanced_2","displayName":"Enable Boot to Cloud Dedicated Mode (Cloud only)","dependedOnBy":[]}]}]