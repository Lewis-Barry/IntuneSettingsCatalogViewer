tionpolicy.networkresetblocked_false","options":[{"itemId":"com.android.devicerestrictionpolicy.networkresetblocked_false","displayName":"False","dependedOnBy":[]},{"itemId":"com.android.devicerestrictionpolicy.networkresetblocked_true","displayName":"True","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"com.android.devicerestrictionpolicy.minimumwifisecuritylevel","name":"MinimumWifiSecurityLevel","displayName":"Select minimum Wi-Fi security level","description":"Select what Wi-Fi security levels are required to connect to Wi-Fi networks. 'Open network security' allows the device to connect to all types of Wi-Fi networks. 'Personal network security' requires personal networks such as WEP, WPA2-PSK. 'Enterprise network security' requires enterprise EAP networks. 'Enterprise 192-bit network security' requires 192-bit networks. Available for fully managed, dedicated, and corporate-owned work profile devices.","categoryId":"929c169a-3480-467c-9f47-d1836b359ef7","baseUri":"/com.android.deviceRestrictionPolicy/","offsetUri":"/minimumWifiSecurityLevel/","rootDefinitionId":"com.android.devicerestrictionpolicy.minimumwifisecuritylevel","uxBehavior":"dropdown","applicability":{"platform":"androidEnterprise","technologies":"android"},"defaultOptionId":"com.android.devicerestrictionpolicy.minimumwifisecuritylevel_opennetworksecurity","options":[{"itemId":"com.android.devicerestrictionpolicy.minimumwifisecuritylevel_opennetworksecurity","displayName":"Open network security","dependedOnBy":[]},{"itemId":"com.android.devicerestrictionpolicy.minimumwifisecuritylevel_personalnetworksecurity","displayName":"Personal network security","dependedOnBy":[]},{"itemId":"com.android.devicerestrictionpolicy.minimumwifisecuritylevel_enterprisenetworksecurity","displayName":"Enterprise network security","dependedOnBy":[]},{"itemId":"com.android.devicerestrictionpolicy.minimumwifisecuritylevel_enterprisebit192networksecurity","displayName":"Enterprise 192-bit network security","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"com.android.devicerestrictionpolicy.cellulartwogblocked","name":"CellularTwoGBlocked","displayName":"Block cellular 2G","description":"If 'True', the device prevents cellular 2G functionality, restricting user access to the setting. If 'False', Intune doesn't change or update this setting. By default, the OS follows the default cellular 2G behavior. Available for fully managed, dedicated, and corporate-owned work profile devices.","categoryId":"929c169a-3480-467c-9f47-d1836b359ef7","baseUri":"/com.android.deviceRestrictionPolicy/","offsetUri":"/cellularTwoGBlocked/","rootDefinitionId":"com.android.devicerestrictionpolicy.cellulartwogblocked","uxBehavior":"toggle","applicability":{"platform":"androidEnterprise","technologies":"android"},"defaultOptionId":"com.android.devicerestrictionpolicy.cellulartwogblocked_false","options":[{"itemId":"com.android.devicerestrictionpolicy.cellulartwogblocked_false","displayName":"False","dependedOnBy":[]},{"itemId":"com.android.devicerestrictionpolicy.cellulartwogblocked_true","displayName":"True","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"com.android.devicerestrictionpolicy.airplanemodeblocked","name":"AirplaneModeBlocked","displayName":"Block airplane mode","description":"If 'True', the device is prevented from enabling airplane mode. If 'False', Intune doesn't change or update this setting. By default, the OS follows the default airplane mode behavior. Available for fully managed, dedicated, and corporate-owned work profile devices.","categoryId":"929c169a-3480-467c-9f47-d1836b359ef7","baseUri":"/com.android.deviceRestrictionPolicy/","offsetUri":"/airplaneModeBlocked/","rootDefinitionId":"com.android.devicerestrictionpolicy.airplanemodeblocked","uxBehavior":"toggle","applicability":{"platform":"andr