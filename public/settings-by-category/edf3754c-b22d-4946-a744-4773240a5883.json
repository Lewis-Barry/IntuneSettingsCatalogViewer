[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_datausage_setcost3g","name":"SetCost3G","displayName":"Set 3G Cost","description":"This policy setting configures the cost of 3G connections on the local machine.\n\nIf this policy setting is enabled, a drop-down list box presenting possible cost values will be active.  Selecting one of the following values from the list will set the cost of all 3G connections on the local machine:\n\n- Unrestricted: Use of this connection is unlimited and not restricted by usage charges and capacity constraints. \n\n- Fixed: Use of this connection is not restricted by usage charges and capacity constraints up to a certain data limit. \n\n- Variable: This connection is costed on a per byte basis.\n\nIf this policy setting is disabled or is not configured, the cost of 3G connections is Fixed by default.\n      ","categoryId":"edf3754c-b22d-4946-a744-4773240a5883","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/DataUsage/SetCost3G","rootDefinitionId":"device_vendor_msft_policy_config_datausage_setcost3g","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-datausage#datausage-setcost3g"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_datausage_setcost3g_0","options":[{"itemId":"device_vendor_msft_policy_config_datausage_setcost3g_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_datausage_setcost3g_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_datausage_setcost3g_cost3g_dropdownlist","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_datausage_setcost4g_cost4g_dropdownlist","name":"Cost4G_Dropdownlist","displayName":"Please select a 4G connection cost 