[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_updatepolicy","name":"WINAPP_UpdatePolicy","displayName":"Turn off automatic updates for Windows App","description":"Controls how the Windows App checks for and installs updates.\n\nIf you enable this policy, choose one of the following options:\n  \n  Enable updates: Windows App will automatically check for and install updates from all sources.\n  Disable updates from all locations: Windows App will not check for or install updates from any source.\n  Disable updates from the Microsoft Store: Windows App will not download updates from the Microsoft Store but may still update from other sources.\n  Disable updates from non-store CDN location: Windows App will not download updates from non-store CDN sources but may still update from the Microsoft Store.\n\nIf you disable or do not configure this policy, automatic updates are enabled for Windows App.\n      ","categoryId":"fa45b2a8-738c-4bac-acc8-7e5bcd6ea6cb","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/windowsApp~Policy~WINAPP_NODE/WINAPP_UpdatePolicy","rootDefinitionId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_updatepolicy","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_updatepolicy_0","options":[{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_updatepolicy_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_updatepolicy_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_updatepolicy_winapp_updatemode","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_updatepolicy_winapp_updatemode","name":"WINAPP_UpdateMode","displayName":"Update restriction:","categoryId":"fa45b2a8-738c-4bac-acc8-7e5bcd6ea6cb","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/windowsApp~Policy~WINAPP_NODE/WINAPP_UpdatePolicy","rootDefinitionId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_updatepolicy","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_updatepolicy_winapp_updatemode_0","options":[{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_updatepolicy_winapp_updatemode_0","displayName":"Enable updates","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_updatepolicy_winapp_updatemode_1","displayName":"Disable updates from all locations","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_updatepolicy_winapp_updatemode_2","displayName":"Disable updates from the Microsoft Store","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_updatepolicy_winapp_updatemode_3","displayName":"Disable updates from non-store CDN location","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_adminreleasering_winapp_adminreleaseringvalueenum","name":"WINAPP_AdminReleaseRingValueEnum","displayName":"Admin Release Ring:","categoryId":"fa45b2a8-738c-4bac-acc8-7e5bcd6ea6cb","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/windowsApp~Policy~WINAPP_NODE/WINAPP_AdminReleaseRing","rootDefinitionId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_adminreleasering","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_adminreleasering_winapp_adminreleaseringvalueenum_0","options":[{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_adminreleasering_winapp_adminreleaseringvalueenum_0","displayName":"Public","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_adminreleasering_winapp_adminreleaseringvalueenum_3","displayName":"Insider","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_adminreleasering","name":"WINAPP_AdminReleaseRing","displayName":"Admin Release Ring Policy","description":"Allows administrators to specify the release ring for the Windows App.\n\nIf you enable this policy, choose one of the following options:\n\n  Public: The Windows App uses the standard release ring.\n  Insider: The Windows App uses the Insider release ring for early access to features.\n\nIf you disable or do not configure this policy, the Windows App uses the Public release ring.\n      ","categoryId":"fa45b2a8-738c-4bac-acc8-7e5bcd6ea6cb","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/windowsApp~Policy~WINAPP_NODE/WINAPP_AdminReleaseRing","rootDefinitionId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_adminreleasering","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_adminreleasering_0","options":[{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_adminreleasering_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_adminreleasering_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_adminreleasering_winapp_adminreleaseringvalueenum","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_skipfre","name":"WINAPP_SkipFRE","displayName":"Skip First Run Experience (FRE)","description":"Skips the initial first-run experience and quick tour when the Windows App launches, taking the user directly to the connection center.\n\nIf you enable this policy, the first-run experience and quick tour are skipped.\n\nIf you disable or do not configure this policy, the first-run experience and quick tour will appear when the Windows App launches for the first time.\n      ","categoryId":"fa45b2a8-738c-4bac-acc8-7e5bcd6ea6cb","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/windowsApp~Policy~WINAPP_NODE/WINAPP_SkipFRE","rootDefinitionId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_skipfre","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_skipfre_0","options":[{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_skipfre_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_skipfre_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_autologoff_winapp_autologofftimeout","name":"WINAPP_AutoLogoffTimeout","displayName":"Inactivity timeout (minutes):","categoryId":"fa45b2a8-738c-4bac-acc8-7e5bcd6ea6cb","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/windowsApp~Policy~WINAPP_NODE/WINAPP_AutoLogoff","rootDefinitionId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_autologoff","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_autologoff","name":"WINAPP_AutoLogoff","displayName":"Automatically log off users after inactive interval","description":"Automatically signs out of the Windows App after a period of inactivity. This does not sign the user out of any remote session.\n\nIf you enable this policy, specify the inactivity timeout in minutes. After the specified time of inactivity, the Windows App will automatically sign out.\n\nIf you disable or do not configure this policy, the Windows App will remain signed in regardless of inactivity.\n      ","categoryId":"fa45b2a8-738c-4bac-acc8-7e5bcd6ea6cb","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/windowsApp~Policy~WINAPP_NODE/WINAPP_AutoLogoff","rootDefinitionId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_autologoff","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_autologoff_0","options":[{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_autologoff_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_autologoff_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_autologoff_winapp_autologofftimeout","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_autocreatedesktopshortcuts","name":"WINAPP_AutoCreateDesktopShortcuts","displayName":"Automatically creates Windows App shortcuts to desktop","description":"Automatically creates Windows App shortcuts to the desktop to launch resources specified by the IT administrator.\n\nIf you enable this policy, Windows App will automatically create desktop shortcuts for resources configured by the IT admin in the Azure Virtual Desktop portal. After the user signs in, these shortcuts will be created on the desktop. When the user signs out, the shortcuts will be automatically cleaned up.\n\nIf you disable or do not configure this policy, desktop shortcuts will not be automatically created.\n      ","categoryId":"fa45b2a8-738c-4bac-acc8-7e5bcd6ea6cb","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/windowsApp~Policy~WINAPP_NODE/WINAPP_AutoCreateDesktopShortcuts","rootDefinitionId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_autocreatedesktopshortcuts","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_autocreatedesktopshortcuts_0","options":[{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_autocreatedesktopshortcuts_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_windowsapp~policy~winapp_node_winapp_autocreatedesktopshortcuts_1","displayName":"Enabled","dependedOnBy":[]}]}]