ion_disablefradminpinbyfolder_disablepincontacts_1","displayName":"True","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"user_vendor_msft_policy_config_admx_folderredirection_disablefradminpinbyfolder_disablepinsearches","name":"DisablePinSearches","displayName":"Searches (User)","categoryId":"41081a6b-ec9f-4b4f-b6ae-1d4dda162654","baseUri":"./User/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_FolderRedirection/DisableFRAdminPinByFolder","rootDefinitionId":"user_vendor_msft_policy_config_admx_folderredirection_disablefradminpinbyfolder","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"user_vendor_msft_policy_config_admx_folderredirection_disablefradminpinbyfolder_disablepinsearches_0","options":[{"itemId":"user_vendor_msft_policy_config_admx_folderredirection_disablefradminpinbyfolder_disablepinsearches_0","displayName":"False","dependedOnBy":[]},{"itemId":"user_vendor_msft_policy_config_admx_folderredirection_disablefradminpinbyfolder_disablepinsearches_1","displayName":"True","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"user_vendor_msft_policy_config_admx_folderredirection_localizexprelativepaths_1","name":"LocalizeXPRelativePaths_1","displayName":"Use localized subfolder names when redirecting Start Menu and My Documents (User)","description":"This policy setting allows the administrator to define whether Folder Redirection should use localized names for the All Programs, Startup, My Music, My Pictures, and My Videos subfolders when redirecting the parent Start Menu and legacy My Documents folder respectively.\r\n\r\nIf you enable this policy setting, Windows Vista, Windows 7, Windows 8, and Windows Server 2012 will use localized folder names for these subfolders when redirecting the Start Menu or legacy My Documents folder.\r\n\r\nIf you disable or not configure this policy setting, Windows Vista, Windows 7, Windows 8, and Windows Server 2012 will use the standard English names for these subfolders when redirecting the Start Menu or legacy My Documents folder.\r\n\r\nNote: This policy is valid only on Windows Vista, Windows 7, Windows 8, and Windows Server 2012 when it processes a legacy redirection policy already deployed for these folders in your existing localized environment.\r\n ","categoryId":"41081a6b-ec9f-4b4f-b6ae-1d4dda162654","baseUri":"./User/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_FolderRedirection/LocalizeXPRelativePaths_1","rootDefinitionId":"user_vendor_msft_policy_config_admx_folderredirection_localizexprelativepaths_1","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-folderredirection#admx-folderredirection-localizexprelativepaths-1"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"user_vendor_msft_policy_config_admx_folderredirection_localizexprelativepaths_1_0","options":[{"itemId":"user_vendor_msft_policy_config_admx_folderredirection_localizexprelativepaths_1_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"user_vendor_msft_policy_config_admx_folderredirection_localizexprelativepaths_1_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"user_vendor_msft_policy_config_admx_folderredirection_folderredirectionenablecacherename","name":"FolderRedirectionEnableCacheRename","displayName":"Enable optimized move of contents in Offline Files cache on Folder Redirection server path change (User)","description":"This policy setting controls whether the contents of redirected folders is copied from the old location to the new location or simply renamed in the Offline Files cache when a folder is redirected to a new location.\r\n\r\nIf you enable this policy setting, when the path to a redirected folder is changed from one network location to another and Folder Redirection is configured to move the content to the new location, instead of copying the content to the new location, the cached content is renamed in the local cache and not copied to the new location. To use this policy setting, you must move or restore the server content to the new network location using a method that preserves the state of the files, including their timestamps, before updating the Folder Redirection location.\r\n\r\nIf you disable or do not configure this policy setting, when the path to a redirected folder is changed and Folder Redirection is configured to move the content to the new location, Windows copies the contents of the local cache to the new network location, then deleted the content from the old network location.\r\n      \r\n ","categoryId":"41081a6b-ec9f-4b4f-b6ae-1d4dda162654","baseUri":"./User/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_FolderRedirection/FolderRedirectionEnableCacheRename","rootDefinitionId":"user_vendor_msft_policy_config_admx_folderredirection_folderredirectionenablecacherename","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-folderredirection#admx-folderredirection-folderredirectionenablecacherename"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"user_vendor_msft_policy_config_admx_folderredirection_folderredirectionenablecacherename_0","options":[{"itemId":"user_vendor_msft_policy_config_admx_folderredirection_folderredirectionenablecacherename_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"user_vendor_msft_policy_config_admx_folderredirection_folderredirectionenablecacherename_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_folderredirection_localizexprelativepaths_2","name":"LocalizeXPRelativePaths_2","displayName":"Use localized subfolder names when redirecting Start Menu and My Documents","description":"This policy setting allows the administrator to define whether Folder Redirection should use localized names for the All Programs, Startup, My Music, My Pictures, and My Videos subfolders when redirecting the parent Start Menu and legacy My Documents folder respectively.\r\n\r\nIf you enable this policy setting, Windows Vista, Windows 7, Windows 8, and Windows Server 2012 will use localized folder names for these subfolders when redirecting the Start Menu or legacy My Documents folder.\r\n\r\nIf you disable or not configure this policy setting, Windows Vista, Windows 7, Windows 8, and Windows Server 2012 will use the standard English names for these subfolders when redirecting the Start Menu or legacy My Documents folder.\r\n\r\nNote: This policy is valid only on Windows Vista, Windows 7, Windows 8, and Windows Server 2012 when it processes a legacy redirection policy already deployed for these folders in your existing localized environment.\r\n ","categoryId":"41081a6b-ec9f-4b4f-b6ae-1d4dda162654","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_FolderRedirection/LocalizeXPRelativePaths_2","rootDefinitionId":"device_vendor_msft_policy_config_admx_folderredirection_localizexprelativepaths_2","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-folderredirection#admx-folderredirection-localizexprelativepaths-2"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_folderredirection_localizexprelativepaths_2_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_folderredirection_localizexprelativepaths_2_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_folderredirection_localizexprelativepaths_2_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDe