onfigure this policy setting and the user has redirected folders, the folders are redirected on every computer that the user logs on to.\r\n\r\nNote: If you enable this policy setting in Computer Configuration and User Configuration, the Computer Configuration policy setting takes precedence.\r\n      \r\n ","categoryId":"41081a6b-ec9f-4b4f-b6ae-1d4dda162654","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_FolderRedirection/PrimaryComputer_FR_2","rootDefinitionId":"device_vendor_msft_policy_config_admx_folderredirection_primarycomputer_fr_2","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-folderredirection#admx-folderredirection-primarycomputer-fr-2"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_folderredirection_primarycomputer_fr_2_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_folderredirection_primarycomputer_fr_2_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_folderredirection_primarycomputer_fr_2_1","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"user_vendor_msft_policy_config_admx_folderredirection_disablefradminpinbyfolder_disablepindocuments","name":"DisablePinDocuments","displayName":"Documents (User)","categoryId":"41081a6b-ec9f-4b4f-b6ae-1d4dda162654","baseUri":"./User/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_FolderRedirection/DisableFRAdminPinByFolder","rootDefinitionId":"user_vendor_msft_policy_config_admx_folderredirection_disablefradminpinbyfolder","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"user_vendor_msft_policy_config_admx_folderredirection_disablefradminpinbyfolder_disablepindocuments_0","options":[{"itemId":"user_vendor_msft_policy_config_admx_folderredirection_disablefradminpinby