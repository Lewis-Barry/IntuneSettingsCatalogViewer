[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_remoteremediation_cloudremediationsettings_enablecloudremediation","name":"EnableCloudRemediation","displayName":"Enable Cloud Remediation (Windows Insiders only)","description":"Enable or disable quick machine recovery, a feature that will search for device recovery solutions if your device fails to start.\r\n This setting is only available to Windows Insiders","categoryId":"52e76943-bfc9-4fb5-bdc8-5d4e8c6a436e","baseUri":"./Vendor/MSFT/RemoteRemediation","offsetUri":"/CloudRemediationSettings/EnableCloudRemediation","rootDefinitionId":"device_vendor_msft_remoteremediation_cloudremediationsettings_enablecloudremediation","uxBehavior":"default","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/RemoteRemediation-csp/"],"applicability":{"platform":"windows10","technologies":"mdm"},"options":[{"itemId":"device_vendor_msft_remoteremediation_cloudremediationsettings_enablecloudremediation_true","displayName":"Cloud remediation enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_remoteremediation_cloudremediationsettings_autoremediationsettings_enableautoremediation","required":false}]},{"itemId":"device_vendor_msft_remoteremediation_cloudremediationsettings_enablecloudremediation_false","displayName":"Cloud remediation disabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_remoteremediation_cloudremediationsettings_networksettings_networkcredentials_networkpasswordencryptiontype","name":"NetworkPasswordEncryptionType","displayName":"Network Password Encryption Type (Windows Insiders only)","description":"Refers to the type of encryption that can be used for the network password. If you specify \"Encrypt with custom certificate\" you must also enter the encryption store.\r\n This setting is only available to Windows Insiders","categoryId":"52e769