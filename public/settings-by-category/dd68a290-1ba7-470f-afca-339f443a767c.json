on Lock when the user enables Find My. This setting is available for supervised devices in iOS 7 and later, and macOS 10.15 and later.","categoryId":"dd68a290-1ba7-470f-afca-339f443a767c","offsetUri":"Settings/[{0}]/MDMOptions/MDMOptions/ActivationLockAllowedWhileSupervised","rootDefinitionId":"settings_item_mdmoptions","uxBehavior":"toggle","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"defaultOptionId":"settings_item_mdmoptions_mdmoptions_activationlockallowedwhilesupervised_false","options":[{"itemId":"settings_item_mdmoptions_mdmoptions_activationlockallowedwhilesupervised_false","displayName":"Blocked","dependedOnBy":[]},{"itemId":"settings_item_mdmoptions_mdmoptions_activationlockallowedwhilesupervised_true","displayName":"Allowed","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSettingGroupCollectionDefinition","id":"settings_item_mdmoptions","name":"Settings_item_MDMOptions","displayName":"MDM Options","description":"A dictionary that contains settings related to the MDM protocol. This setting doesn't support user enrollment. Available in iOS 7 and later, macOS 10.15 and later, and visionOS 2 and later.","categoryId":"dd68a290-1ba7-470f-afca-339f443a767c","offsetUri":"Settings/[{0}]/MDMOptions","rootDefinitionId":"settings_item_mdmoptions","uxBehavior":"default","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[{"dependedOnBy":"settings_item_mdmoptions_mdmoptions","required":true}]}]