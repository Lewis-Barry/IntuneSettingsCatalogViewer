er.\r\n\r\nIf you disable or do not configure this policy setting, the default folder will be used.","categoryId":"a92d0868-54e7-4a4f-a9f0-87bb1b81af3a","baseUri":"./User/Vendor/MSFT/Policy","offsetUri":"/Config/excel16v2~Policy~L_MicrosoftOfficeExcel~L_ExcelOptions~L_Save/L_Defaultfilelocation","rootDefinitionId":"user_vendor_msft_policy_config_excel16v2~policy~l_microsoftofficeexcel~l_exceloptions~l_save_l_defaultfilelocation","uxBehavior":"toggle","applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"user_vendor_msft_policy_config_excel16v2~policy~l_microsoftofficeexcel~l_exceloptions~l_save_l_defaultfilelocation_0","options":[{"itemId":"user_vendor_msft_policy_config_excel16v2~policy~l_microsoftofficeexcel~l_exceloptions~l_save_l_defaultfilelocation_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"user_vendor_msft_policy_config_excel16v2~policy~l_microsoftofficeexcel~l_exceloptions~l_save_l_defaultfilelocation_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"user_vendor_msft_policy_config_excel16v2~policy~l_microsoftofficeexcel~l_exceloptions~l_save_l_defaultfilelocation_l_defaultfilelocation0","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"user_vendor_msft_policy_config_excel16v2~policy~l_microsoftofficeexcel~l_exceloptions~l_save_l_autorecovertime_l_saveautorecoverinfoevery","name":"L_SaveAutoRecoverinfoevery","displayName":"Save AutoRecover info every (minutes): (User)","categoryId":"a92d0868-54e7-4a4f-a9f0-87bb1b81af3a","baseUri":"./User/Vendor/MSFT/Policy","offsetUri":"/Config/excel16v2~Policy~L_MicrosoftOfficeExcel~L_ExcelOptions~L_Save/L_AutoRecovertime","rootDefinitionId":"user_vendor_msft_policy_config_excel16v2~policy~l_microsoftofficeexcel~l_exceloptions~l_save_l_autorecovertime","uxBehavior":"default","applicability":{"platform":"windows10","technologies":"mdm"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigura