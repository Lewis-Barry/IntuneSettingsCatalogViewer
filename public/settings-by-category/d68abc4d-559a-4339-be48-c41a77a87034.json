[{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"com.apple.mobiledevice.passwordpolicy_mincomplexchars","name":"minComplexChars","displayName":"Min Complex Characters","description":"The minimum number of complex characters that a passcode must contain. A complex character is a character other than a number or a letter, such as & % $ #. This property is ignored for User Enrollments.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"minComplexChars","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"default","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"com.apple.mobiledevice.passwordpolicy_customregex_passwordcontentdescription_generickey","name":"customRegex_passwordContentDescription_genericKey","displayName":"Description","description":"A localized description.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"customRegex/passwordContentDescription/{0}","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"default","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"com.apple.mobiledevice.passwordpolicy_pinhistory","name":"pinHistory","displayName":"PIN History","description":"This value defines N, where the new passcode must be unique within the last N entries in the passcode history. ","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"pinHistory","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"default","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"com.apple.mobiledevice.passwordpolicy_minutesuntilfailedloginreset","name":"minutesUntilFailedLoginReset","displayName":"Minutes Until Failed Login Reset","description":"The number of minutes before the login is reset after the maximum number of unsuccessful login attempts is reached. This key requires setting Max Failed Attempts. Available in macOS 10.10 and later.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"minutesUntilFailedLoginReset","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"com.apple.mobiledevice.passwordpolicy_forcepin","name":"forcePIN","displayName":"Force PIN","description":"If true, forces the user to enter a PIN.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"forcePIN","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"toggle","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"defaultOptionId":"com.apple.mobiledevice.passwordpolicy_forcepin_false","options":[{"itemId":"com.apple.mobiledevice.passwordpolicy_forcepin_false","displayName":"False","dependedOnBy":[]},{"itemId":"com.apple.mobiledevice.passwordpolicy_forcepin_true","displayName":"True","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSettingGroupCollectionDefinition","id":"com.apple.mobiledevice.passwordpolicy_customregex","name":"customRegex","displayName":"Custom Regex","description":"Specifies a regular expression, and its description, used to enforce password compliance. Use the simpler passcode restrictions whenever possible, and rely on regular expression matching only when necessary. Mistakes in regular expressions can lead to frustrating user experiences, such as unsatisfiable passcode policies, or policy descriptions that don't match the enforced policy.\n\nAvailable in macOS 14 and later.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"customRegex","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_customregex_passwordcontentregex","required":true},{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_customregex_passwordcontentdescription","required":false}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"com.apple.mobiledevice.passwordpolicy_maxfailedattempts","name":"maxFailedAttempts","displayName":"Max Failed Attempts","description":"The number of allowed failed attempts to enter the passcode at the device's lock screen. After six failed attempts, a time delay is imposed before a passcode can be entered again. The delay increases with each attempt. In macOS, set Minutes Until Failed Login Reset to define a delay before the next passcode can be entered. When this number is exceeded in macOS, the device is locked; in iOS, the device is wiped.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"maxFailedAttempts","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"default","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_minutesuntilfailedloginreset","required":false}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"com.apple.mobiledevice.passwordpolicy_changeatnextauth","name":"changeAtNextAuth","displayName":"Change At Next Auth","description":"If true, causes a password reset to occur the next time the user tries to authenticate. If this key is set in a device profile, the setting takes effect for all users, and admin authentications may fail until the admin user password is also reset. Available in macOS 10.13 and later.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"changeAtNextAuth","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"toggle","applicability":{"platform":"macOS","technologies":"mdm,appleRemoteManagement"},"defaultOptionId":"com.apple.mobiledevice.passwordpolicy_changeatnextauth_false","options":[{"itemId":"com.apple.mobiledevice.passwordpolicy_changeatnextauth_false","displayName":"False","dependedOnBy":[]},{"itemId":"com.apple.mobiledevice.passwordpolicy_changeatnextauth_true","displayName":"True","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"com.apple.mobiledevice.passwordpolicy_allowsimple","name":"allowSimple","displayName":"Allow Simple Passcode","description":"If true, allows a simple passcode. A simple passcode contains repeated characters, or increasing or decreasing characters (such as 123 or CBA). Setting this value to false has the same result as setting Min Complex Characters to 1.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"allowSimple","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"toggle","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"defaultOptionId":"com.apple.mobiledevice.passwordpolicy_allowsimple_true","options":[{"itemId":"com.apple.mobiledevice.passwordpolicy_allowsimple_false","displayName":"False","dependedOnBy":[]},{"itemId":"com.apple.mobiledevice.passwordpolicy_allowsimple_true","displayName":"True","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"com.apple.mobiledevice.passwordpolicy_requirealphanumeric","name":"requireAlphanumeric","displayName":"Require Alphanumeric Passcode","description":"If true, requires alphabetic characters (abcd) instead of only numeric characters.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"requireAlphanumeric","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"toggle","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"defaultOptionId":"com.apple.mobiledevice.passwordpolicy_requirealphanumeric_false","options":[{"itemId":"com.apple.mobiledevice.passwordpolicy_requirealphanumeric_false","displayName":"False","dependedOnBy":[]},{"itemId":"com.apple.mobiledevice.passwordpolicy_requirealphanumeric_true","displayName":"True","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"com.apple.mobiledevice.passwordpolicy_minlength","name":"minLength","displayName":"Min Length","description":"The minimum overall length of the passcode. This parameter is independent of the also optional Min Complex Characters argument.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"minLength","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"default","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSettingGroupCollectionDefinition","id":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","name":"com.apple.mobiledevice.passwordpolicy","displayName":"Top Level Setting Group Collection","description":"Synthetic Top Level Setting Group Collection","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"com.apple.mobiledevice.passwordpolicy","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"default","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_allowsimple","required":false},{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_forcepin","required":false},{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_maxfailedattempts","required":false},{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_maxinactivity","required":false},{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_maxpinageindays","required":false},{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_mincomplexchars","required":false},{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_minlength","required":false},{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_requirealphanumeric","required":false},{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_pinhistory","required":false},{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_maxgraceperiod","required":false},{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_changeatnextauth","required":false},{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_customregex","required":false},{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_minutesuntilfailedloginreset","required":false}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"com.apple.mobiledevice.passwordpolicy_maxpinageindays","name":"maxPINAgeInDays","displayName":"Max PIN Age In Days","description":"The number of days for which the passcode can remain unchanged. After this number of days, the user is forced to change the passcode before the device is unlocked.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"maxPINAgeInDays","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"default","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSettingGroupCollectionDefinition","id":"com.apple.mobiledevice.passwordpolicy_customregex_passwordcontentdescription","name":"customRegex_passwordContentDescription","displayName":"Password Content Description","description":"Contains a dictionary of keys for supported OS language IDs (for example, \"en-US\"), and whose values represent a localized description of the policy enforced by the regular expression. Use the special `default` key can for languages that aren't contained in the dictionary.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"customRegex/passwordContentDescription","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"contextPane","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_customregex_passwordcontentdescription_generickey","required":false},{"dependedOnBy":"com.apple.mobiledevice.passwordpolicy_customregex_passwordcontentdescription_generickey_keytobereplaced","required":true}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"com.apple.mobiledevice.passwordpolicy_customregex_passwordcontentregex","name":"customRegex_passwordContentRegex","displayName":"Password Content Regex","description":"A regular expression string that they system matches against the password to determine whether it complies with a policy. The regular expression uses the ICU syntax (<https://unicode-org.github.io/icu/userguide/strings/regexp.html>). The string must not exceed 2048 characters in length.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"customRegex/passwordContentRegex","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"default","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"com.apple.mobiledevice.passwordpolicy_maxgraceperiod","name":"maxGracePeriod","displayName":"Max Grace Period","description":"The maximum grace period, in minutes, to unlock the phone without entering a passcode. The default is 0, which is no grace period and requires a passcode immediately. In macOS, this grace period value is translated to screen-saver settings.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"maxGracePeriod","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"default","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"com.apple.mobiledevice.passwordpolicy_customregex_passwordcontentdescription_generickey_keytobereplaced","name":"customRegex_passwordContentDescription","displayName":"Password Content Description","description":"Contains a dictionary of keys for supported OS language IDs (for example, \"en-US\"), and whose values represent a localized description of the policy enforced by the regular expression. Use the special `default` key can for languages that aren't contained in the dictionary.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"customRegex/passwordContentDescription","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"default","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"com.apple.mobiledevice.passwordpolicy_maxinactivity","name":"maxInactivity","displayName":"Max Inactivity","description":"The maximum number of minutes for which the device can be idle, without being unlocked by the user, before it gets locked by the system. When this limit is reached, the device is locked and the passcode must be entered. The user can edit this setting, but the value cannot exceed the Max Inactivity value. In macOS, this inactivity value is translated to screen-saver settings.","categoryId":"d68abc4d-559a-4339-be48-c41a77a87034","offsetUri":"maxInactivity","rootDefinitionId":"com.apple.mobiledevice.passwordpolicy_com.apple.mobiledevice.passwordpolicy","uxBehavior":"default","applicability":{"platform":"iOS,macOS","technologies":"mdm,appleRemoteManagement"},"dependedOnBy":[]}]