policy_config_admx_microsoftdefenderantivirus_exclusions_extensions","name":"Exclusions_Extensions","displayName":"Extension Exclusions","description":"This policy setting allows you specify a list of file types that should be excluded from scheduled, custom, and real-time scanning. File types should be added under the Options for this setting. Each entry must be listed as a name value pair, where the name should be a string representation of the file type extension (such as \"obj\" or \"lib\"). The value is not used and it is recommended that this be set to 0.\r\n ","categoryId":"edba50d5-da3c-48cb-8e50-381ad0bfaaaf","baseUri":"./Device/Vendor/MSFT/Policy","offsetUri":"/Config/ADMX_MicrosoftDefenderAntivirus/Exclusions_Extensions","rootDefinitionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_exclusions_extensions","uxBehavior":"toggle","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-admx-microsoftdefenderantivirus#admx-microsoftdefenderantivirus-exclusions-extensions"],"applicability":{"platform":"windows10","technologies":"mdm"},"defaultOptionId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_exclusions_extensions_0","options":[{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_exclusions_extensions_0","displayName":"Disabled","dependedOnBy":[]},{"itemId":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_exclusions_extensions_1","displayName":"Enabled","dependedOnBy":[{"dependedOnBy":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_exclusions_extensions_exclusions_extensionslist","required":true}]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"device_vendor_msft_policy_config_admx_microsoftdefenderantivirus_exclusions_paths","name":"Exclusions_Paths","displayName":"Path Exclusions","description":"This policy setting allows you to disable scheduled and real-time scanning for files under