efaultOptionId":"contentcaching_localsubnetsonly_true","options":[{"itemId":"contentcaching_localsubnetsonly_false","displayName":"Disabled","dependedOnBy":[]},{"itemId":"contentcaching_localsubnetsonly_true","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"contentcaching_parentselectionpolicy","name":"ParentSelectionPolicy","displayName":"Parent Selection Policy","description":"The policy to implement when choosing among more than one configured parent content cache. With every policy, the system skips parent caches that are temporarily unavailable. Allowed values:\n\n- `first-available`: Always use the first available parent in the Parents list. Use this policy to designate permanent primary, secondary, and subsequent parents.\n- `url-path-hash`: Hash the path part of the requested URL so that the same parent is always used for the same URL. This is useful for maximizing the size of the combined caches of     the parents.\n- `random`: Choose a parent at random. Use this policy for load balancing.\n- `round-robin`: Rotate through the parents in order. Use this policy for load balancing.\n- `sticky-available`: Use the first available parent in the Parents list until it becomes unavailable, then advance to the next one. Use this policy for designating floating primary, secondary, and subsequent parents.","categoryId":"5c9e9aaf-a36c-437f-b85a-cb78a527a80f","offsetUri":"ParentSelectionPolicy","rootDefinitionId":"contentcaching_contentcaching","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"appleRemoteManagement"},"defaultOptionId":"contentcaching_parentselectionpolicy_3","options":[{"itemId":"contentcaching_parentselectionpolicy_0","displayName":"first-available","dependedOnBy":[]},{"itemId":"contentcaching_parentselectionpolicy_1","displayName":"url-path-hash","dependedOnBy":[]},{"itemId":"contentcaching_parentselectionpolicy_2","displayName":"random","dependedOnBy":[]},{"itemId":"contentcaching_parentselectionpolicy_3","displayName":"round-robin","dependedOnBy":[]},{"itemId":"contentcaching_parentselectionpolicy_4","displayName":"sticky-available","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"contentcaching_peerfilterranges_item_type","name":"PeerFilterRanges_item_type","displayName":"Type","description":"The IP address type.","categoryId":"5c9e9aaf-a36c-437f-b85a-cb78a527a80f","offsetUri":"PeerFilterRanges/[{0}]/type","rootDefinitionId":"contentcaching_contentcaching","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"appleRemoteManagement"},"defaultOptionId":"contentcaching_peerfilterranges_item_type_0","options":[{"itemId":"contentcaching_peerfilterranges_item_type_0","displayName":"IPv4","dependedOnBy":[]},{"itemId":"contentcaching_peerfilterranges_item_type_1","displayName":"IPv6","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"contentcaching_peerlistenranges_item_first","name":"PeerListenRanges_item_first","displayName":"First","description":"The first IP address in the range.","categoryId":"5c9e9aaf-a36c-437f-b85a-cb78a527a80f","offsetUri":"PeerListenRanges/[{0}]/first","rootDefinitionId":"contentcaching_contentcaching","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"contentcaching_allowpersonalcaching","name":"AllowPersonalCaching","displayName":"Allow Personal Caching","description":"If `true`, the system caches the user's iCloud data. Changes to this value don't have an immediate effect. Clients may take some time to react to changes.\n\n> Note:\n> At least one of the `AllowPersonalCaching` or `AllowSharedCaching` keys need to be `true`.","categoryId":"5c9e9aaf-a36c-437f-b85a-cb78a527a80f","offsetUri":"AllowPersonalCaching","rootDefinitionId":"contentcaching_contentcaching","uxBehavior":"toggle","applicability":{"platform":"macOS","technologies":"appleRemoteManagement"},"defaultOptionId":"contentcaching_allowpersonalcaching_true","options":[{"itemId":"contentcaching_allowpersonalcaching_false","displayName":"Blocked","dependedOnBy":[]},{"itemId":"contentcaching_allowpersonalcaching_true","displayName":"Allowed","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"contentcaching_denytetheredcaching","name":"DenyTetheredCaching","displayName":"Deny Tethered Caching","description":"If `true`, the system disables tethered caching.","categoryId":"5c9e9aaf-a36c-437f-b85a-cb78a527a80f","offsetUri":"DenyTetheredCaching","rootDefinitionId":"contentcaching_contentcaching","uxBehavior":"toggle","applicability":{"platform":"macOS","technologies":"appleRemoteManagement"},"defaultOptionId":"contentcaching_denytetheredcaching_false","options":[{"itemId":"contentcaching_denytetheredcaching_false","displayName":"Disabled","dependedOnBy":[]},{"itemId":"contentcaching_denytetheredcaching_true","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","id":"contentcaching_listenrangesonly","name":"ListenRangesOnly","displayName":"Listen Ranges Only","description":"If `true`, the content cache provides content to the clients in the `ListenRanges`.","categoryId":"5c9e9aaf-a36c-437f-b85a-cb78a527a80f","offsetUri":"ListenRangesOnly","rootDefinitionId":"contentcaching_contentcaching","uxBehavior":"toggle","applicability":{"platform":"macOS","technologies":"appleRemoteManagement"},"defaultOptionId":"contentcaching_listenrangesonly_false","options":[{"itemId":"contentcaching_listenrangesonly_false","displayName":"Disabled","dependedOnBy":[]},{"itemId":"contentcaching_listenrangesonly_true","displayName":"Enabled","dependedOnBy":[]}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingCollectionDefinition","id":"contentcaching_parents","name":"Parents","displayName":"Parents","description":"An array of the local IP addresses of other content caches that this cache should download from or upload to, instead of downloading from or uploading to Apple directly. The system ignores invalid addresses and addresses of computers that aren't content caches. The system skips Parent caches that become unavailable. If all parent content caches become unavailable, the content cache downloads from or uploads to Apple directly, until a parent content cache becomes available again.","categoryId":"5c9e9aaf-a36c-437f-b85a-cb78a527a80f","offsetUri":"Parents","rootDefinitionId":"contentcaching_contentcaching","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"contentcaching_peerfilterranges_item_first","name":"PeerFilterRanges_item_first","displayName":"First","description":"The first IP address in the range.","categoryId":"5c9e9aaf-a36c-437f-b85a-cb78a527a80f","offsetUri":"PeerFilterRanges/[{0}]/first","rootDefinitionId":"contentcaching_contentcaching","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","id":"contentcaching_datapath","name":"DataPath","displayName":"Data Path","description":"The path to the directory used to store cached content. Changing this setting manually doesn't automatically move cached content from the old location to the new one. To move content automatically, use the Sharing preference's Content Caching pane. The value must be (or end with) `/Library/Application Support/Apple/AssetCache/Data`.\n\nThe system creates a directory and its intermediates for the given data path if it doesn't already exist. The directory is owned by `_assetcache:_assetcache` and has mode 0750. Its immediate parent directory (`.../Library/Application Support/Apple/AssetCache`) is owned by `_assetcache:_assetcache` and has mode `0755`.","categoryId":"5c9e9aaf-a36c-437f-b85a-cb78a527a80f","offsetUri":"DataPath","rootDefinitionId":"contentcaching_contentcaching","uxBehavior":"default","applicability":{"platform":"macOS","technologies":"appleRemoteManagement"},"dependedOnBy":[]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSettingGroupCollectionDefinition","id":"contentcaching_peerfilterranges","name":"PeerFilterRanges","displayName":"Peer Filter Ranges","description":"An array of dictionaries describing a range of peer IP addresses that the content cache uses to filter its list of peers to query for content. The content cache only queries peers in `PeerFilterRanges`. When `PeerFilterRanges` is an empty array, the content cache doesn't query any peers.","categoryId":"5c9e9aaf-a36c-437f-b85a-cb78a527a80f","offsetUri":"PeerFilterRanges","rootDefinitionId":"contentcaching_contentcaching","uxBehavior":"contextPane","applicability":{"platform":"macOS","technologies":"appleRemoteManagement"},"dependedOnBy":[{"dependedOnBy":"contentcaching_peerfilterranges_item_type","required":false},{"dependedOnBy":"contentcaching_peerfilterranges_item_first","required":true},{"dependedOnBy":"contentcaching_peerfilterranges_item_last","required":true}]},{"@odata.type":"#microsoft.graph.deviceManagementConfigurationSettingGroupCollectionDefinition","id":"contentcaching_publicranges","name":"PublicRanges","displayName":"Public Ranges","description":"An array of dictionaries describing a range of public IP addresses that the cloud servers should use for matching clients to content caches.","categoryId":"5c9e9aaf-a36c-437f-b85a-cb78a527a80f","offsetUri":"PublicRanges","rootDefinitionId":"contentcaching_contentcaching","uxBehavior":"contextPane","applicability":{"platform":"macOS","technologies":"appleRemoteManagement"},"dependedOnBy":[{"dependedOnBy":"contentcaching_publicranges_item_type","required":false},{"dependedOnBy":"contentcaching_publicranges_item_first","required":true},{"dependedOnBy":"contentcaching_publicranges_item_last","required":true}]}]